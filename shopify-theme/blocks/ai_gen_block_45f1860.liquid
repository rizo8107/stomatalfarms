{% doc %}
  @prompt
    Generate a offer banner with image tittle desctipin and cta follwing the theme and mobile and desktop optimised and option to edit and upload images  please gicve iamge size too , please update the mobile ui alone thext is affecting nad image area is too small , add gradient ype overlya left sold and reght rtransperent, Add a tiny ribbon above the headline: "Festive Sale — ends soon."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-offer-banner-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto}.ai-offer-banner-{{ ai_gen_id }}__inner{position:relative;display:flex;align-items:{{ block.settings.vertical_alignment }};min-height:{{ block.settings.banner_height }}px;overflow:hidden;border-radius:{{ block.settings.corner_radius }}px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}.ai-offer-banner-{{ ai_gen_id }}__media,.ai-offer-banner-{{ ai_gen_id }}__media img,.ai-offer-banner-{{ ai_gen_id }}__placeholder{position:absolute;inset:0;width:100%;height:100%}.ai-offer-banner-{{ ai_gen_id }}__media img{object-fit:cover}.ai-offer-banner-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center;background:#e8eee8;color:#536354}.ai-offer-banner-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;max-width:420px;max-height:420px}.ai-offer-banner-{{ ai_gen_id }}__overlay{position:absolute;inset:0;background:linear-gradient(90deg,{{ block.settings.overlay_color }} 0%,{{ block.settings.overlay_color | color_modify:'alpha',0.72 }} 30%,{{ block.settings.overlay_color | color_modify:'alpha',0.25 }} 58%,transparent 100%);opacity:{{ block.settings.overlay_opacity | divided_by:100.0 }}}.ai-offer-banner-{{ ai_gen_id }}__content{position:relative;z-index:1;width:100%;max-width:{{ block.settings.content_width }}px;padding:48px;text-align:{{ block.settings.text_alignment }}}.ai-offer-banner-{{ ai_gen_id }}__ribbon{display:inline-block;margin:0 0 14px;padding:6px 11px;border-radius:3px;background:{{ block.settings.ribbon_background }};color:{{ block.settings.ribbon_text_color }};font-size:11px;font-weight:700;letter-spacing:.08em;line-height:1.2;text-transform:uppercase}.ai-offer-banner-{{ ai_gen_id }}__eyebrow{margin:0 0 10px;color:{{ block.settings.accent_color }};font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.ai-offer-banner-{{ ai_gen_id }}__title{max-width:680px;margin:0 0 14px;color:{{ block.settings.text_color }};font-size:{{ block.settings.title_size }}px;line-height:1.08}.ai-offer-banner-{{ ai_gen_id }}__description{max-width:560px;margin:0 0 24px;color:{{ block.settings.text_color }};font-size:16px;line-height:1.55}.ai-offer-banner-{{ ai_gen_id }}__description p{margin:0}.ai-offer-banner-{{ ai_gen_id }}__cta{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 24px;border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font-size:15px;font-weight:700;text-decoration:none}.ai-offer-banner-{{ ai_gen_id }}__cta:hover{opacity:.85}.ai-offer-banner-{{ ai_gen_id }}__cta:focus-visible{outline:3px solid {{ block.settings.accent_color }};outline-offset:3px}@media screen and (max-width:749px){.ai-offer-banner-{{ ai_gen_id }}{width:100%}.ai-offer-banner-{{ ai_gen_id }}__inner{display:flex;flex-direction:column;align-items:stretch;min-height:0}.ai-offer-banner-{{ ai_gen_id }}__media{position:relative;inset:auto;display:block;flex:0 0 {{ block.settings.mobile_image_height }}px;width:100%;height:{{ block.settings.mobile_image_height }}px;z-index:1}.ai-offer-banner-{{ ai_gen_id }}__media img,.ai-offer-banner-{{ ai_gen_id }}__placeholder{position:absolute}.ai-offer-banner-{{ ai_gen_id }}__media--desktop{display:none}.ai-offer-banner-{{ ai_gen_id }}__overlay{display:none}.ai-offer-banner-{{ ai_gen_id }}__content{box-sizing:border-box;max-width:none;padding:28px 24px 32px;background:{{ block.settings.background_color }};text-align:{{ block.settings.mobile_alignment }}}.ai-offer-banner-{{ ai_gen_id }}__title{font-size:{{ block.settings.mobile_title_size }}px}.ai-offer-banner-{{ ai_gen_id }}__description{font-size:15px;margin-bottom:20px}}@media screen and (min-width:750px){.ai-offer-banner-{{ ai_gen_id }}__media--mobile{display:none}}
/* Align banner content with the theme's max-w-7xl (1280px) container. The generated rule used a flat 48px gutter, which left the text out of line with every other section on the page. */.ai-offer-banner-{{ ai_gen_id }}__content{box-sizing:border-box;max-width:none;padding-left:max(20px,calc((100% - 1280px) / 2 + 20px));padding-right:max(20px,calc((100% - 1280px) / 2 + 20px))}@media screen and (min-width:768px){.ai-offer-banner-{{ ai_gen_id }}__content{padding-left:max(40px,calc((100% - 1280px) / 2 + 40px));padding-right:max(40px,calc((100% - 1280px) / 2 + 40px))}}/* Keep the text column narrow now that the padding box spans full width. */.ai-offer-banner-{{ ai_gen_id }}__content > *{max-width:{{ block.settings.content_width }}px}.ai-offer-banner-{{ ai_gen_id }}__ribbon{max-width:none}/* Mobile: overlay the copy on the artwork instead of stacking a solid panel beneath it, matching the desktop treatment and the approved design. */@media screen and (max-width:749px){.ai-offer-banner-{{ ai_gen_id }}__inner{position:relative;min-height:420px;aspect-ratio:4 / 5}.ai-offer-banner-{{ ai_gen_id }}__media{position:absolute;inset:0;width:100%;height:100%;flex:none;z-index:0}.ai-offer-banner-{{ ai_gen_id }}__media img,.ai-offer-banner-{{ ai_gen_id }}__placeholder{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.ai-offer-banner-{{ ai_gen_id }}__overlay{display:block;z-index:0;opacity:1;background:linear-gradient(180deg,rgba(22,34,25,.88) 0%,rgba(22,34,25,.55) 38%,rgba(22,34,25,.12) 68%,rgba(22,34,25,.42) 100%)}{%- assign m_align = block.settings.mobile_alignment | default: 'left' -%}{%- if m_align == 'center' -%}{%- assign flex_align = 'center' -%}{%- elsif m_align == 'right' -%}{%- assign flex_align = 'flex-end' -%}{%- else -%}{%- assign flex_align = 'flex-start' -%}{%- endif -%}.ai-offer-banner-{{ ai_gen_id }}__content{position:relative;z-index:1;flex:1;display:flex;flex-direction:column;align-items:{{ flex_align }};background:transparent;padding:28px 20px 32px}.ai-offer-banner-{{ ai_gen_id }}__cta{margin-top:auto}}{% endstyle %}<div class="ai-offer-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-offer-banner-{{ ai_gen_id }}__inner"><div class="ai-offer-banner-{{ ai_gen_id }}__media ai-offer-banner-{{ ai_gen_id }}__media--desktop">{% if block.settings.desktop_image %}<img src="{{ block.settings.desktop_image | image_url:width:2400 }}" alt="{{ block.settings.desktop_image.alt | escape }}" loading="lazy" width="{{ block.settings.desktop_image.width }}" height="{{ block.settings.desktop_image.height }}">{% else %}<div class="ai-offer-banner-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-offer-banner-{{ ai_gen_id }}__media ai-offer-banner-{{ ai_gen_id }}__media--mobile">{% if block.settings.mobile_image %}<img src="{{ block.settings.mobile_image | image_url:width:1600 }}" alt="{{ block.settings.mobile_image.alt | escape }}" loading="lazy" width="{{ block.settings.mobile_image.width }}" height="{{ block.settings.mobile_image.height }}">{% elsif block.settings.desktop_image %}<img src="{{ block.settings.desktop_image | image_url:width:1600 }}" alt="{{ block.settings.desktop_image.alt | escape }}" loading="lazy" width="{{ block.settings.desktop_image.width }}" height="{{ block.settings.desktop_image.height }}">{% else %}<div class="ai-offer-banner-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-offer-banner-{{ ai_gen_id }}__overlay"></div><div class="ai-offer-banner-{{ ai_gen_id }}__content">{% if block.settings.ribbon_text != blank %}<div class="ai-offer-banner-{{ ai_gen_id }}__ribbon">{{ block.settings.ribbon_text }}</div>{% endif %}{% if block.settings.eyebrow != blank %}<p class="ai-offer-banner-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}{% if block.settings.title != blank %}<h2 class="ai-offer-banner-{{ ai_gen_id }}__title">{{ block.settings.title }}</h2>{% endif %}{% if block.settings.description != blank %}<div class="ai-offer-banner-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% endif %}{% if block.settings.cta_label != blank and block.settings.cta_link != blank %}<a class="ai-offer-banner-{{ ai_gen_id }}__cta" href="{{ block.settings.cta_link }}">{{ block.settings.cta_label }}</a>{% endif %}</div></div></div>
{% schema %}{"name":"Offer banner","settings":[{"type":"header","content":"Content"},{"type":"text","id":"ribbon_text","label":"Ribbon text","default":"Festive Sale — ends soon."},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Limited-time offer"},{"type":"text","id":"title","label":"Title","default":"Fresh value for your everyday rituals"},{"type":"richtext","id":"description","label":"Description","default":"<p>Explore thoughtfully made products and enjoy more value in every order.</p>"},{"type":"text","id":"cta_label","label":"Button label","default":"Shop the offer"},{"type":"url","id":"cta_link","label":"Button link"},{"type":"header","content":"Images"},{"type":"paragraph","content":"Recommended image sizes: desktop 2400 × 1000 px; mobile 1600 × 1600 px. Use WebP or JPG for faster loading."},{"type":"image_picker","id":"desktop_image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"banner_height","label":"Desktop height","min":280,"max":700,"step":20,"unit":"px","default":460},{"type":"range","id":"mobile_image_height","label":"Mobile image height","min":220,"max":560,"step":20,"unit":"px","default":360},{"type":"range","id":"content_width","label":"Content width","min":320,"max":800,"step":20,"unit":"px","default":600},{"type":"select","id":"vertical_alignment","label":"Vertical alignment","options":[{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}],"default":"center"},{"type":"radio","id":"text_alignment","label":"Desktop alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"left"},{"type":"radio","id":"mobile_alignment","label":"Mobile alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},{"type":"range","id":"title_size","label":"Desktop title size","min":28,"max":72,"step":2,"unit":"px","default":48},{"type":"range","id":"mobile_title_size","label":"Mobile title size","min":24,"max":52,"step":2,"unit":"px","default":34},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#25382A"},{"type":"color","id":"text_color","label":"Text","default":"#FFFFFF"},{"type":"color","id":"accent_color","label":"Accent","default":"#E7C873"},{"type":"color","id":"overlay_color","label":"Overlay","default":"#162219"},{"type":"color","id":"ribbon_background","label":"Ribbon background","default":"#E7C873"},{"type":"color","id":"ribbon_text_color","label":"Ribbon text","default":"#25382A"},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":80,"step":5,"unit":"%","default":35},{"type":"color","id":"button_color","label":"Button","default":"#E7C873"},{"type":"color","id":"button_text_color","label":"Button text","default":"#25382A"},{"type":"range","id":"corner_radius","label":"Banner radius","min":0,"max":32,"step":2,"unit":"px","default":12},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":6}],"presets":[{"name":"Offer banner"}],"tag":null,"class":"offer-banner-block"}
{% endschema %}