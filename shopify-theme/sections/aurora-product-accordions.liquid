{%- comment -%}
  Aurora: compact stack of collapsed rows under the buy box (Description, Benefits,
  Usage, Comparison, FAQ, Legal Metrology...). Native <details>, no JS.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign current_variant = product.selected_or_first_available_variant
-%}
{%- if section.blocks.size > 0 -%}
<section
  class="aurora-section aurora-acc"
  id="aurora-acc-{{ section.id }}"
  style="{% render 'aurora-section-vars', s: s %} --acc-max: {{ s.max_width }}px;{% if s.line_color != blank and s.line_color.alpha != 0.0 %} --acc-line: {{ s.line_color }};{% endif %}{% if s.title_color != blank and s.title_color.alpha != 0.0 %} --acc-title: {{ s.title_color }};{% endif %}"
>
  <div class="aurora-acc__inner">
    {%- if s.heading != blank -%}
      <h2 class="aurora-section__heading aurora-acc__heading">{{ s.heading }}</h2>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign body = ''
        case block.type
          when 'description'
            assign body = product.description | default: b.fallback
          when 'content'
            assign body = b.liquid | default: b.content
        endcase
        assign show = true
        if block.type == 'description' or block.type == 'content'
          if body == blank
            assign show = false
          endif
        endif
      -%}
      {%- if show -%}
        <details class="aurora-block aurora-acc__item w-full" {% if b.open %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="aurora-acc__summary">
            <span class="aurora-acc__title">{{ b.title }}</span>
            <span class="aurora-acc__chevron" aria-hidden="true"><svg viewBox="0 0 20 20" width="14" height="14"><path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </summary>
          <div class="aurora-acc__panel">
            {%- case block.type -%}
              {%- when 'description', 'content' -%}
                <div class="aurora-acc__body{% if b.image != blank %} aurora-acc__body--image{% endif %}">
                  {%- if b.image != blank -%}
                    <div class="aurora-acc__image">
                      {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 768px) 360px, 100vw' }}
                    </div>
                  {%- endif -%}
                  <div class="rte">{{ body }}</div>
                </div>

              {%- when 'comparison' -%}
                <div class="aurora-acc__table-wrap">
                  <table class="aurora-acc__table">
                    <thead>
                      <tr><th scope="col"></th><th scope="col" class="is-brand">{{ b.brand_label }}</th><th scope="col">{{ b.other_label }}</th></tr>
                    </thead>
                    <tbody>
                      {%- assign rows = b.rows | newline_to_br | split: '<br />' -%}
                      {%- for row in rows -%}
                        {%- assign cells = row | strip | split: '|' -%}
                        {%- if cells.size >= 3 -%}
                          <tr>
                            <th scope="row">{{ cells[0] | strip }}</th>
                            <td class="is-brand"><span class="aurora-acc__yes" aria-hidden="true">{%- render 'aurora-icon', icon: 'check' -%}</span> {{ cells[1] | strip }}</td>
                            <td><span class="aurora-acc__no" aria-hidden="true">{%- render 'aurora-icon', icon: 'close' -%}</span> {{ cells[2] | strip }}</td>
                          </tr>
                        {%- endif -%}
                      {%- endfor -%}
                    </tbody>
                  </table>
                </div>
                {%- if b.note != blank -%}<p class="aurora-acc__note">{{ b.note }}</p>{%- endif -%}

              {%- when 'faq' -%}
                <div class="aurora-acc__faq">
                  {%- for i in (1..8) -%}
                    {%- liquid
                      assign q_key = 'question_' | append: i
                      assign a_key = 'answer_' | append: i
                    -%}
                    {%- if b[q_key] != blank -%}
                      <details class="aurora-acc__q">
                        <summary>{{ b[q_key] }}</summary>
                        <div class="rte">{{ b[a_key] }}</div>
                      </details>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

              {%- when 'specs' -%}
                <dl class="aurora-acc__specs">
                  {%- if b.show_mrp -%}
                    <div><dt>MRP</dt><dd>{{ current_variant.compare_at_price | default: current_variant.price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }} (inclusive of all taxes)</dd></div>
                  {%- endif -%}
                  {%- assign rows = b.rows | newline_to_br | split: '<br />' -%}
                  {%- for row in rows -%}
                    {%- assign cells = row | strip | split: '|' -%}
                    {%- if cells.size >= 2 -%}
                      <div><dt>{{ cells[0] | strip }}</dt><dd>{{ cells[1] | strip }}</dd></div>
                    {%- endif -%}
                  {%- endfor -%}
                </dl>
            {%- endcase -%}
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Aurora: Info accordions",
  "tag": "div",
  "class": "x-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Optional" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 1300 },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 18, "max": 60, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 16, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "card_radius", "label": "Image corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 12 },
    { "type": "header", "content": "Colours" },
    { "type": "paragraph", "content": "Leave a colour transparent to use the theme colour." },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "title_color", "label": "Row titles", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "line_color", "label": "Divider lines", "default": "#D9B866" },
    { "type": "color", "id": "accent_color", "label": "Accent (ticks, brand column)", "default": "rgba(0,0,0,0)" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "Product description",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Description" },
        { "type": "richtext", "id": "fallback", "label": "Text when the product has no description" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)", "info": "800 × 800 px" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "content",
      "name": "Text row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Benefits" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "liquid", "id": "liquid", "label": "Dynamic content (Liquid)", "info": "Optional. Overrides the content above, e.g. {{ product.metafields.custom.how_to_use | metafield_tag }}. The row hides when both are empty." },
        { "type": "image_picker", "id": "image", "label": "Image (optional)", "info": "800 × 800 px" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "comparison",
      "name": "Comparison table",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Aurora vs regular incense" },
        { "type": "text", "id": "brand_label", "label": "Brand column", "default": "Aurora" },
        { "type": "text", "id": "other_label", "label": "Other column", "default": "Regular incense" },
        { "type": "textarea", "id": "rows", "label": "Rows", "info": "One row per line: Criterion | Aurora | Regular", "default": "Base material | Purified desi cow dung | Charcoal powder" },
        { "type": "text", "id": "note", "label": "Note under table" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Honest answers to common questions" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false },
        { "type": "text", "id": "question_1", "label": "Question 1" }, { "type": "richtext", "id": "answer_1", "label": "Answer 1" },
        { "type": "text", "id": "question_2", "label": "Question 2" }, { "type": "richtext", "id": "answer_2", "label": "Answer 2" },
        { "type": "text", "id": "question_3", "label": "Question 3" }, { "type": "richtext", "id": "answer_3", "label": "Answer 3" },
        { "type": "text", "id": "question_4", "label": "Question 4" }, { "type": "richtext", "id": "answer_4", "label": "Answer 4" },
        { "type": "text", "id": "question_5", "label": "Question 5" }, { "type": "richtext", "id": "answer_5", "label": "Answer 5" },
        { "type": "text", "id": "question_6", "label": "Question 6" }, { "type": "richtext", "id": "answer_6", "label": "Answer 6" },
        { "type": "text", "id": "question_7", "label": "Question 7" }, { "type": "richtext", "id": "answer_7", "label": "Answer 7" },
        { "type": "text", "id": "question_8", "label": "Question 8" }, { "type": "richtext", "id": "answer_8", "label": "Answer 8" }
      ]
    },
    {
      "type": "specs",
      "name": "Specs / Legal Metrology",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Legal Metrology" },
        { "type": "checkbox", "id": "show_mrp", "label": "Show MRP of the selected variant", "default": true },
        { "type": "textarea", "id": "rows", "label": "Rows", "info": "One per line: Label | Value", "default": "Country of origin | India" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurora: Info accordions",
      "category": "Aurora",
      "blocks": [
        { "type": "description" },
        { "type": "content" },
        { "type": "faq" },
        { "type": "specs" }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
