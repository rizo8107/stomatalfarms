{%- comment -%}
  Live Google reviews, fetched client-side from the same self-hosted API the
  React app uses. The section renders the loading (skeleton) state server-side,
  which is exactly what React renders on first paint, then hydrates.
{%- endcomment -%}

<google-reviews-carousel
  data-endpoint="{{ section.settings.reviews_endpoint }}"
  data-fallback-endpoint="{{ 'reviews-fallback.json' | asset_url }}"
  data-avatar-colors="bg-[#4285F4] bg-[#9c6ade] bg-[#0f9d8f] bg-[#ea4335] bg-[#f5a623] bg-[#34a853]"
  data-star-on="fill-[#f5a623] text-[#f5a623]"
  data-star-off="fill-transparent text-[#2a3625]/15"
  data-summary-star-on="w-3.5 h-3.5 fill-[#f5a623] text-[#f5a623]"
  data-summary-star-off="w-3.5 h-3.5 fill-transparent text-[#f5a623]/30"
>
  <section class="pt-10 md:pt-14 pb-4 px-4 bg-[#f9f6f0]">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-6 md:mb-8 flex-wrap gap-4">
        <div class="flex items-center gap-3">
          <svg viewBox="0 0 24 24" class="w-6 h-6 flex-shrink-0" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <div>
            <p class="text-xs font-black uppercase tracking-[0.2em] text-[#4f7a2e]">Google Reviews</p>
            <div class="flex items-center gap-1 mt-0.5">
              <span data-summary-stars class="flex items-center gap-1">
                {% for i in (1..5) %}
                  {% render 'icon', name: 'star', class: 'w-3.5 h-3.5 fill-[#f5a623] text-[#f5a623]' %}
                {% endfor %}
              </span>
              <span data-summary-rating class="text-sm font-bold text-[#2a3625] ml-1">4.7</span>
              <span data-summary-total class="text-xs text-[#6a7462] ml-1">· 50+ reviews</span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
          <select
            data-star-filter
            class="text-xs font-semibold text-[#2a3625] bg-white border border-[#2a3625]/10 rounded-full px-3 py-1.5"
            aria-label="Filter by rating"
          >
            <option value="all">All Ratings</option>
            <option value="5">5 Stars</option>
            <option value="4">4 Stars</option>
            <option value="3">3 Stars</option>
            <option value="2">2 Stars</option>
            <option value="1">1 Star</option>
          </select>
          <select
            data-sort-mode
            class="text-xs font-semibold text-white bg-[#2a3625] rounded-full px-3 py-1.5"
            aria-label="Sort reviews"
          >
            <option value="newest">Latest Ratings</option>
            <option value="highest">Highest Ratings</option>
          </select>
          <div class="hidden md:flex items-center gap-2">
            <button
              type="button"
              data-carousel-prev
              class="w-9 h-9 rounded-full border border-[#2a3625]/10 bg-white flex items-center justify-center text-[#2a3625] hover:bg-[#2a3625] hover:text-white transition-all duration-300 shadow-sm"
              aria-label="Previous review"
            >
              {% render 'icon', name: 'chevron-left', class: 'w-4 h-4' %}
            </button>
            <button
              type="button"
              data-carousel-next
              class="w-9 h-9 rounded-full border border-[#2a3625]/10 bg-white flex items-center justify-center text-[#2a3625] hover:bg-[#2a3625] hover:text-white transition-all duration-300 shadow-sm"
              aria-label="Next review"
            >
              {% render 'icon', name: 'chevron-right', class: 'w-4 h-4' %}
            </button>
          </div>
        </div>
      </div>

      <div class="embla overflow-hidden">
        <div data-review-track class="embla__container flex gap-3 md:gap-4">
          {%- comment -%} Loading skeletons — replaced once the fetch resolves. {%- endcomment -%}
          {% for i in (1..4) %}
            <div class="flex-[0_0_80%] sm:flex-[0_0_46%] md:flex-[0_0_30%] lg:flex-[0_0_22%] min-w-0">
              <div class="rounded-2xl bg-white border border-[#2a3625]/10 p-5 h-[180px] animate-pulse">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-9 h-9 rounded-full bg-[#2a3625]/10"></div>
                  <div class="flex-1">
                    <div class="h-3 w-24 bg-[#2a3625]/10 rounded mb-2"></div>
                    <div class="h-2 w-16 bg-[#2a3625]/10 rounded"></div>
                  </div>
                </div>
                <div class="h-2 w-full bg-[#2a3625]/10 rounded mb-2"></div>
                <div class="h-2 w-4/5 bg-[#2a3625]/10 rounded"></div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <p data-swipe-hint class="text-center text-xs text-[#6a7462]/60 mt-4 md:hidden" hidden>Swipe to see more reviews</p>
    </div>
  </section>

  {%- comment -%}
    Card template. Kept in Liquid (not in theme.js) so Tailwind's content scanner,
    which only reads *.liquid, still sees every class name used at runtime.
  {%- endcomment -%}
  <template data-review-card-template>
    <div class="flex-[0_0_80%] sm:flex-[0_0_46%] md:flex-[0_0_30%] lg:flex-[0_0_22%] min-w-0">
      <div class="rounded-2xl bg-white border border-[#2a3625]/10 p-5 h-full flex flex-col gap-3 shadow-sm">
        <div class="flex items-center gap-3">
          <span class="relative flex h-9 w-9 shrink-0 overflow-hidden rounded-full">
            <img data-avatar-image width="36" height="36" class="aspect-square h-full w-full" alt="" hidden>
            <span data-avatar-fallback class="flex h-full w-full items-center justify-center rounded-full text-white text-xs font-semibold"></span>
          </span>
          <div class="min-w-0">
            <p data-author class="text-sm font-semibold text-[#1a1f16] truncate"></p>
            <div data-stars class="flex items-center gap-0.5 mt-0.5"></div>
          </div>
        </div>
        <p class="text-sm text-[#5b6455] leading-relaxed flex-1">
          <span data-text></span><button type="button" data-toggle class="text-[#4f7a2e] font-semibold ml-1 hover:underline" hidden></button>
        </p>
        <div class="border-t border-[#2a3625]/10 pt-3">
          <span data-relative-time class="text-xs text-[#8a927f]"></span>
        </div>
      </div>
    </div>
  </template>
</google-reviews-carousel>

{% schema %}
{
  "name": "Google reviews carousel",
  "settings": [
    {
      "type": "text",
      "id": "reviews_endpoint",
      "label": "Reviews API endpoint",
      "info": "Absolute URL to the self-hosted /api/reviews endpoint. Must send CORS headers allowing this storefront's origin.",
      "default": "https://stomatalfarms.com/api/reviews"
    }
  ],
  "presets": [{ "name": "Google reviews carousel" }]
}
{% endschema %}
