{%- comment -%}
  Aurora: Export / distribution / private-label page (from "Aurora Distributor Page.pdf").
  Everything is editable: texts in section settings, cards as blocks.
  The enquiry form is Shopify's contact form – submissions arrive in the store's email inbox.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign profile_link = s.profile_link | default: '#enquire'
  assign wa = s.whatsapp | remove: '+' | remove: ' ' | remove: '-'
-%}
{%- style -%}
  #aurora-dist-{{ section.id }} {
    --d-dark: {{ s.color_dark }}; --d-dark-2: {{ s.color_dark_2 }}; --d-cream: {{ s.color_cream }};
    --d-gold: {{ s.color_gold }}; --d-ink: {{ s.color_ink }};
    --d-serif: var(--font-heading-family);
  }
{%- endstyle -%}

{%- comment -%}
  Handle gate. page.distributor.json is an *alternate* template, and the admin's
  Template dropdown only lists templates from the published theme - so until this
  theme is live, the page sits on "Default page". Listing the handle here lets the
  section render on the default template instead. Blank shows it everywhere.
{%- endcomment -%}
{%- liquid
  assign show_section = true
  assign only = s.limit_handles | strip
  if only != blank
    assign show_section = false
    assign wanted = only | downcase | split: ','
    for h in wanted
      assign want = h | strip
      if want != blank and page.handle == want
        assign show_section = true
      endif
    endfor
  endif
-%}
{%- if show_section -%}
{%- if s.hide_page_title -%}
  {%- comment -%}
    The page title duplicates this section's own heading. Hidden from here
    rather than by switching it off on main-page, which would also strip the
    title from Contact and Micro Greens - they share the default template.
  {%- endcomment -%}
  <style>
    .page__container .page__title { display: none; }
    .page__container div:has(> .page__title) { margin-bottom: 0; }
    /* The wrapper keeps its 20px/28px padding once the heading is hidden,
       leaving an empty strip between the header and this section. */
    section.x-section-page > div.x-section-page { padding-block: 0; }
  </style>
{%- endif -%}
<div class="aurora-dist" id="aurora-dist-{{ section.id }}">
  {%- comment -%} 1. Hero {%- endcomment -%}
  <section class="aurora-dist__hero">
    <div class="aurora-dist__wrap aurora-dist__hero-grid">
      <div>
        {%- if s.eyebrow != blank -%}<p class="aurora-dist__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h1 class="aurora-dist__h1">{{ s.heading }}</h1>
        {%- if s.text != blank -%}<div class="aurora-dist__lead">{{ s.text }}</div>{%- endif -%}
        <div class="aurora-dist__ctas">
          {%- if s.cta_label != blank -%}<a class="aurora-dist__btn aurora-dist__btn--gold" href="#enquire">{{ s.cta_label }}</a>{%- endif -%}
          {%- if s.profile_label != blank -%}
            <a class="aurora-dist__btn aurora-dist__btn--ghost" href="{{ profile_link }}"{% if s.profile_link != blank %} target="_blank" rel="noopener"{% endif %}>{{ s.profile_label }}</a>
          {%- endif -%}
        </div>
      </div>
      <div class="aurora-dist__badges">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <div class="aurora-dist__badge" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} 2. Who we work with {%- endcomment -%}
  <section class="aurora-dist__light" id="partners">
    <div class="aurora-dist__wrap">
      <h2 class="aurora-dist__h2">{{ s.who_heading }}</h2>
      {%- if s.who_text != blank -%}<p class="aurora-dist__sub">{{ s.who_text }}</p>{%- endif -%}
      <div class="aurora-dist__cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'partner' -%}
            <div class="aurora-dist__card" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
              {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                <span class="aurora-dist__card-icon" aria-hidden="true">{% render 'aurora-icon', icon: block.settings.icon %}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} 3. The range {%- endcomment -%}
  <section class="aurora-dist__dark" id="range">
    <div class="aurora-dist__wrap">
      <h2 class="aurora-dist__h2">{{ s.range_heading }}</h2>
      {%- if s.range_text != blank -%}<p class="aurora-dist__sub">{{ s.range_text }}</p>{%- endif -%}
      <div class="aurora-dist__range">
        {%- for block in section.blocks -%}
          {%- if block.type == 'range_item' -%}
            <div class="aurora-dist__range-item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="aurora-dist__range-img">{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 20vw, 45vw' }}</div>
              {%- endif -%}
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ s.range_link_label }} →</a>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} 4. How it works + terms {%- endcomment -%}
  <section class="aurora-dist__dark aurora-dist__dark--alt" id="how-it-works">
    <div class="aurora-dist__wrap">
      <h2 class="aurora-dist__h2">{{ s.how_heading }}</h2>
      <ol class="aurora-dist__steps">
        {%- assign step_n = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_n = step_n | plus: 1 -%}
            <li class="aurora-dist__step" {{ block.shopify_attributes }}>
              <span class="aurora-dist__num">{% if step_n < 10 %}0{% endif %}{{ step_n }}</span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
      <dl class="aurora-dist__terms">
        {%- for block in section.blocks -%}
          {%- if block.type == 'term' -%}
            <div class="aurora-dist__term" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label }}</dt>
              <dd>{{ block.settings.value }}</dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    </div>
  </section>

  {%- comment -%} 5. Enquiry form {%- endcomment -%}
  <section class="aurora-dist__light" id="enquire">
    <div class="aurora-dist__wrap aurora-dist__contact">
      <div>
        <h2 class="aurora-dist__h2">{{ s.form_heading }}</h2>
        {%- if s.form_text != blank -%}<p class="aurora-dist__sub">{{ s.form_text }}</p>{%- endif -%}
        <dl class="aurora-dist__facts">
          {%- if s.email != blank -%}<div><dt>Email</dt><dd><a href="mailto:{{ s.email }}">{{ s.email }}</a></dd></div>{%- endif -%}
          {%- if s.whatsapp != blank -%}<div><dt>WhatsApp</dt><dd><a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{{ s.whatsapp }}</a></dd></div>{%- endif -%}
          {%- if s.based_in != blank -%}<div><dt>Based in</dt><dd>{{ s.based_in }}</dd></div>{%- endif -%}
          {%- if s.company != blank -%}<div><dt>Company</dt><dd>{{ s.company }}</dd></div>{%- endif -%}
        </dl>
      </div>
      <div class="aurora-dist__form-card">
        {%- form 'contact', id: 'AuroraDistForm', class: 'aurora-dist__form' -%}
          <input type="hidden" name="contact[Enquiry type]" value="Distributor / export enquiry">
          {%- if form.posted_successfully? -%}
            <p class="aurora-dist__success" tabindex="-1" autofocus>{{ s.success_text }}</p>
          {%- else -%}
            {%- if form.errors -%}<p class="aurora-dist__error">{{ form.errors | default_errors }}</p>{%- endif -%}
            <div class="aurora-dist__fields">
              <label>Full name<input type="text" name="contact[name]" autocomplete="name" required></label>
              <label>Company name<input type="text" name="contact[Company]" autocomplete="organization" required></label>
              <label>Email<input type="email" name="contact[email]" autocomplete="email" required></label>
              <label>Phone / WhatsApp<input type="tel" name="contact[phone]" autocomplete="tel" required></label>
              <label>Country<input type="text" name="contact[Country]" autocomplete="country-name" required></label>
              <label>I'm interested in
                <select name="contact[Interested in]">
                  {%- assign options = s.interest_options | newline_to_br | split: '<br />' -%}
                  {%- for o in options -%}{%- assign o = o | strip -%}{%- if o != blank -%}<option>{{ o }}</option>{%- endif -%}{%- endfor -%}
                </select>
              </label>
              <label>Products of interest<input type="text" name="contact[Products of interest]" placeholder="e.g. incense cups, ghee diyas"></label>
              <label>Estimated monthly volume
                <select name="contact[Monthly volume]">
                  {%- assign options = s.volume_options | newline_to_br | split: '<br />' -%}
                  {%- for o in options -%}{%- assign o = o | strip -%}{%- if o != blank -%}<option>{{ o }}</option>{%- endif -%}{%- endfor -%}
                </select>
              </label>
              <label class="aurora-dist__full">Tell us about your business<textarea name="contact[body]" rows="4"></textarea></label>
            </div>
            <button type="submit" class="aurora-dist__btn aurora-dist__btn--dark">{{ s.submit_label }}</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </section>
</div>
{%- endif -%}

