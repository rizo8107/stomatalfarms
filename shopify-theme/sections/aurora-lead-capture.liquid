{%- liquid
  assign s = section.settings
  assign has_image = false
  if s.image != blank or request.design_mode
    assign has_image = true
  endif
-%}
<section
  class="aurora-section aurora-lead aurora-lead--text-{{ s.text_alignment }}"
  id="aurora-lead-{{ section.id }}"
  style="{% render 'aurora-section-vars', s: s %} --as-max-w: {{ s.max_width }}px;"
>
  <div class="aurora-lead__inner aurora-lead__inner--image-{{ s.image_position }}{% unless has_image %} aurora-lead__inner--no-image{% endunless %}{% unless s.show_box %} aurora-lead__inner--plain{% endunless %}{% if s.hide_image_mobile %} aurora-lead__inner--hide-image-mobile{% endif %}">
    {%- if has_image -%}
      <div class="aurora-lead__image">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1100
            | image_tag: loading: 'lazy', widths: '450, 700, 900, 1100', sizes: '(min-width: 768px) 480px, 100vw'
          }}
        {%- else -%}
          <div class="aurora-placeholder" style="aspect-ratio: 1 / 1;">
            {{ 'image' | placeholder_svg_tag: 'aurora-placeholder__svg' }}
            <span class="aurora-placeholder__label"><strong>Lead capture image</strong>1080 × 1080 px</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="aurora-lead__content">
      {%- if s.offer_badge != blank -%}
        <span class="aurora-lead__offer">{{ s.offer_badge }}</span>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="aurora-section__heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="aurora-lead__text">{{ s.text }}</div>
      {%- endif -%}

      {%- assign lead_form_id = 'AuroraLead-' | append: section.id -%}
      {%- form 'customer', id: lead_form_id, class: 'aurora-lead__form', data-aurora-lead: '' -%}
        <input type="hidden" name="contact[tags]" value="{{ s.customer_tags | default: 'newsletter,lead-capture' | escape }}">
        <input type="hidden" data-aurora-phone-field value="">
        {%- if form.posted_successfully? -%}
          <p class="aurora-lead__success" tabindex="-1" autofocus>{{ s.success_text }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="aurora-lead__error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          {%- if s.show_phone -%}
            <label class="aurora-visually-hidden" for="AuroraLeadPhone-{{ section.id }}">{{ s.phone_placeholder }}</label>
            <div class="aurora-lead__phone">
              <span>{{ s.country_code | default: '+91' }}</span>
              <input
                id="AuroraLeadPhone-{{ section.id }}"
                type="tel"
                inputmode="numeric"
                autocomplete="tel-national"
                maxlength="10"
                placeholder="{{ s.phone_placeholder | escape }}"
                data-aurora-phone
                {% if s.phone_required %}required{% endif %}
              >
            </div>
          {%- endif -%}
          <label class="aurora-visually-hidden" for="AuroraLeadEmail-{{ section.id }}">{{ s.email_placeholder }}</label>
          <input
            id="AuroraLeadEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            autocomplete="email"
            required
            placeholder="{{ s.email_placeholder | escape }}"
          >
          {%- if s.show_phone and s.show_consent_checkbox -%}
            <label class="aurora-lead__checkbox">
              <input type="checkbox" data-aurora-wa-consent>
              <span>{{ s.consent_checkbox_label }}</span>
            </label>
          {%- endif -%}
          <button type="submit">{{ s.button_label }}</button>
          {%- if s.consent_text != blank -%}
            <p class="aurora-lead__consent">{{ s.consent_text }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aurora: Lead capture",
  "tag": "div",
  "class": "x-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Recommended 1080 × 1080 px (square)"
    },
    {
      "type": "text",
      "id": "offer_badge",
      "label": "Offer badge",
      "default": "Get 10% off your first order"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Aurora family"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Share your WhatsApp number or email and we'll send your 10% off code right away.</p>"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Ask for WhatsApp number",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "phone_required",
      "label": "WhatsApp number required",
      "default": false
    },
    {
      "type": "text",
      "id": "country_code",
      "label": "Country code shown",
      "default": "+91"
    },
    {
      "type": "text",
      "id": "phone_placeholder",
      "label": "Phone placeholder",
      "default": "WhatsApp number"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Email address"
    },
    {
      "type": "checkbox",
      "id": "show_consent_checkbox",
      "label": "Show WhatsApp consent checkbox",
      "info": "Unticked by default, as required by the DPDP Act. Only shoppers who tick it get the whatsapp-optin tag.",
      "default": true
    },
    {
      "type": "text",
      "id": "consent_checkbox_label",
      "label": "Consent checkbox label",
      "default": "Send me offers on WhatsApp"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get my 10% off"
    },
    {
      "type": "text",
      "id": "consent_text",
      "label": "Small print",
      "default": "We'll only message you about offers and new launches. Unsubscribe anytime."
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thank you! Your offer is on its way."
    },
    {
      "type": "text",
      "id": "customer_tags",
      "label": "Customer tags",
      "info": "Comma separated. Added to every sign-up.",
      "default": "newsletter,lead-capture"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "hide_image_mobile",
      "label": "Hide image on mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_box",
      "label": "Show background box",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 960
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Box corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "paragraph",
      "content": "Leave a colour transparent to use the theme colour."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Box background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button and badge",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Input border",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Aurora: Lead capture",
      "category": "Aurora"
    }
  ]
