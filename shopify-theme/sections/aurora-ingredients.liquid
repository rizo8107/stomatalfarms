{%- comment -%}
  Aurora: key-ingredient carousel. Intro on the left, swipeable cards (photo, name,
  what it does, tag pill) on the right.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
{%- if section.blocks.size > 0 -%}
<section
  class="aurora-section aurora-ingr"
  id="aurora-ingr-{{ section.id }}"
  style="{% render 'aurora-section-vars', s: s %}"
>
  <div class="aurora-ingr__inner page-width">
    <div class="aurora-ingr__intro">
      {%- if s.eyebrow != blank -%}<p class="aurora-ingr__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="aurora-section__heading">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="aurora-ingr__text">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank and s.button_link != blank -%}
        <a class="aurora-section__button" href="{{ s.button_link }}">{{ s.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="aurora-ingr__track" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="aurora-ingr__card" role="listitem" {{ block.shopify_attributes }}>
          {%- if b.name != blank -%}<h3 class="aurora-ingr__name">{{ b.name }}</h3>{%- endif -%}
          {%- if b.benefit != blank -%}<p class="aurora-ingr__benefit">{{ b.benefit }}</p>{%- endif -%}
          <div class="aurora-ingr__media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(min-width: 768px) 420px, 78vw', alt: b.name }}
            {%- elsif request.design_mode or s.show_placeholder -%}
              <div class="aurora-placeholder">
                {{ 'image' | placeholder_svg_tag: 'aurora-placeholder__svg' }}
                <span class="aurora-placeholder__label"><strong>{{ b.name | default: 'Ingredient' }} photo</strong>800 × 800 px</span>
              </div>
            {%- endif -%}
            {%- if b.tag != blank -%}<span class="aurora-ingr__tag">{{ b.tag }}</span>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Aurora: Ingredients",
  "tag": "div",
  "class": "x-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Grounded in tradition. Made the natural way." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Powered by purified desi cow dung and sacred herbs" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_placeholder", "label": "Show photo placeholders while empty", "info": "Turn off before publishing if photos aren't ready", "default": true },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 18, "max": 60, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 16, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "card_radius", "label": "Photo corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "header", "content": "Colours" },
    { "type": "paragraph", "content": "Leave a colour transparent to use the theme colour." },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "heading_color", "label": "Heading and ingredient names", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "accent_color", "label": "Button and eyebrow", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "rgba(0,0,0,0)" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Square, 800 × 800 px" },
        { "type": "text", "id": "name", "label": "Name", "default": "Desi cow dung" },
        { "type": "text", "id": "benefit", "label": "What it does", "default": "Purified, solar-dried base that burns clean" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Base" }
      ]
    }
  ],
  "presets": [
    { "name": "Aurora: Ingredients", "category": "Aurora", "blocks": [ { "type": "ingredient" }, { "type": "ingredient" }, { "type": "ingredient" } ] }
  ]
}
{% endschema %}
