{%- comment -%}
  Aurora: single full-width banner with separate desktop/mobile artwork.
  When no image is uploaded it renders a placeholder that states the exact
  artwork size, so the design team knows what to export.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign desktop_image = s.desktop_image | default: s.mobile_image
  assign mobile_image = s.mobile_image
  assign banner_label = s.banner_label | default: 'Banner'
  if s.use_collection_banner and collection
    assign banner_label = banner_label | append: ' – ' | append: collection.title
    assign collection_desktop = collection.metafields.custom.banner_desktop.value
    assign collection_mobile = collection.metafields.custom.banner_mobile.value
    if collection_desktop != blank or collection_mobile != blank
      assign desktop_image = collection_desktop | default: collection_mobile
      assign mobile_image = collection_mobile
    else
      for block in section.blocks
        if block.type != 'collection_art'
          continue
        endif
        for c in block.settings.collections
          if c.handle == collection.handle
            assign art_block = block
            break
          endif
        endfor
        if art_block
          break
        endif
      endfor
    endif
  endif
  assign desktop_asset = ''
  assign mobile_asset = ''
  if art_block
    if art_block.settings.desktop_image != blank or art_block.settings.mobile_image != blank
      assign desktop_image = art_block.settings.desktop_image | default: art_block.settings.mobile_image
      assign mobile_image = art_block.settings.mobile_image
    else
      assign desktop_asset = art_block.settings.desktop_asset
      assign mobile_asset = art_block.settings.mobile_asset
    endif
  endif
  assign has_image = false
  if desktop_image != blank or desktop_asset != blank or mobile_asset != blank
    assign has_image = true
  endif

  comment
    Artwork for filtered views (e.g. ?type=sticks, ?pack=6): rendered hidden, aurora.js shows the match.
  endcomment
  assign alt_count = 0
  for block in section.blocks
    if block.type == 'collection_art' and block.settings.url_match != blank
      assign alt_count = alt_count | plus: 1
    endif
  endfor

  assign d_w = s.desktop_width | at_least: 1
  assign d_h = s.desktop_height | at_least: 1
  assign m_w = s.mobile_width | at_least: 1
  assign m_h = s.mobile_height | at_least: 1

  assign ratio_desktop = d_w | append: ' / ' | append: d_h
  assign ratio_mobile = m_w | append: ' / ' | append: m_h
  if s.height_mode == 'adapt' and desktop_image != blank
    assign ratio_desktop = desktop_image.aspect_ratio
  endif
  if mobile_image != blank
    if s.height_mode == 'adapt'
      assign ratio_mobile = mobile_image.aspect_ratio
    endif
  elsif desktop_image != blank
    comment
      No mobile artwork: keep the desktop proportions so nothing gets cropped.
    endcomment
    if s.height_mode == 'adapt'
      assign ratio_mobile = desktop_image.aspect_ratio
    else
      assign ratio_mobile = ratio_desktop
    endif
  endif

  assign has_content = false
  if s.subheading != blank or s.heading != blank or s.text != blank or s.button_label_1 != blank or s.button_label_2 != blank
    assign has_content = true
  endif

  assign show_placeholder = false
  if has_image == false
    if s.show_placeholder or request.design_mode
      assign show_placeholder = true
    endif
  endif

  assign render_section = true
  assign alt_only = false
  if has_image == false and show_placeholder == false and has_content == false
    assign render_section = false
    if alt_count > 0 and s.use_collection_banner
      assign render_section = true
      assign alt_only = true
    endif
  endif

  assign loading = 'lazy'
  assign priority = 'auto'
  if section.index <= 2
    assign loading = 'eager'
    assign priority = 'high'
  endif

  assign heading_html = s.heading | escape | replace: '[', '<span class="aurora-banner__hl">' | replace: ']', '</span>'
  assign image_alt = desktop_image.alt | default: art_block.settings.alt | default: s.heading | default: collection.title | default: s.banner_label | remove: '[' | remove: ']' | escape
-%}

{%- if render_section -%}
  <div
    id="AuroraBanner-{{ section.id }}"
    class="aurora-banner{% if s.full_width %} aurora-banner--full{% endif %}{% if s.hide_on_mobile %} aurora-banner--hide-mobile{% endif %}{% if s.hide_on_desktop %} aurora-banner--hide-desktop{% endif %}{% if alt_only %} aurora-banner--alt-only{% endif %}{% if alt_count > 0 and s.use_collection_banner %} aurora-banner--has-alts{% endif %} aurora-banner--mobile-{{ s.mobile_content_layout }}"
    style="
      --ab-ratio-d: {{ ratio_desktop }};
      --ab-ratio-m: {{ ratio_mobile }};
      --ab-pt: {{ s.padding_top }}px; --ab-pb: {{ s.padding_bottom }}px;
      --ab-pt-m: {{ s.padding_top_mobile }}px; --ab-pb-m: {{ s.padding_bottom_mobile }}px;
      --ab-radius: {{ s.corner_radius }}px;
      --ab-section-bg: {% if s.section_background.alpha != 0.0 %}{{ s.section_background }}{% else %}transparent{% endif %};
      --ab-frame-bg: {{ s.banner_background }};
      --ab-text: {{ s.text_color }};
      --ab-accent: {{ s.accent_color }};
      --ab-overlay: {{ s.overlay_color }};
      --ab-overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
      --ab-box-bg: {{ s.content_box_color }};
      --ab-box-opacity: {{ s.content_box_opacity | divided_by: 100.0 }};
      --ab-btn-bg: {{ s.button_color }};
      --ab-btn-text: {{ s.button_text_color }};
      --ab-heading-d: {{ s.heading_size }}px; --ab-heading-m: {{ s.heading_size_mobile }}px;
      --ab-content-w: {{ s.content_width }}%;
      --ab-focal: {{ desktop_image.presentation.focal_point | default: 'center' }};
      --ab-focal-m: {{ mobile_image.presentation.focal_point | default: desktop_image.presentation.focal_point | default: 'center' }};
    "
  >
    <div class="aurora-banner__wrap{% unless s.full_width %} page-width{% endunless %}">
      <div class="aurora-banner__frame aurora-banner__frame--{{ s.content_position }} aurora-banner__frame--m-{{ s.content_position_mobile }} aurora-banner__frame--align-{{ s.text_alignment }} aurora-banner__frame--align-m-{{ s.text_alignment_mobile }}">
        {%- if s.link != blank -%}
          <a class="aurora-banner__link" href="{{ s.link }}" aria-label="{{ image_alt }}"></a>
        {%- endif -%}

        {%- if has_image -%}
          {%- render 'aurora-banner-picture',
            desktop_image: desktop_image,
            mobile_image: mobile_image,
            desktop_asset: desktop_asset,
            mobile_asset: mobile_asset,
            alt: image_alt,
            loading: loading,
            priority: priority,
            attrs: 'data-aurora-banner-default'
          -%}
        {%- elsif show_placeholder -%}
          <div class="aurora-banner__placeholder" aria-hidden="true">
            <span class="aurora-banner__ruler aurora-banner__ruler--x">
              <span class="aurora-banner__only-d">{{ d_w }} px</span><span class="aurora-banner__only-m">{{ m_w }} px</span>
            </span>
            <span class="aurora-banner__ruler aurora-banner__ruler--y">
              <span class="aurora-banner__only-d">{{ d_h }} px</span><span class="aurora-banner__only-m">{{ m_h }} px</span>
            </span>
            <div class="aurora-banner__placeholder-label">
              <svg class="aurora-banner__placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.75"/><path d="M21 16l-5.5-5.5L5 20"/></svg>
              <strong>{{ banner_label }}</strong>
              <span class="aurora-banner__size aurora-banner__size--desktop">Desktop · {{ d_w }} × {{ d_h }} px</span>
              <span class="aurora-banner__size aurora-banner__size--mobile">Mobile · {{ m_w }} × {{ m_h }} px</span>
              {%- if s.placeholder_note != blank -%}
                <span class="aurora-banner__note">{{ s.placeholder_note }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if alt_count > 0 and s.use_collection_banner -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection_art' and block.settings.url_match != blank -%}
              {%- capture alt_attrs -%}hidden data-aurora-banner-alt="{{ block.settings.url_match | escape }}"{%- endcapture -%}
              {%- assign alt_text = block.settings.alt | default: image_alt | escape -%}
              {%- render 'aurora-banner-picture',
                desktop_image: block.settings.desktop_image,
                mobile_image: block.settings.mobile_image,
                desktop_asset: block.settings.desktop_asset,
                mobile_asset: block.settings.mobile_asset,
                alt: alt_text,
                loading: 'lazy',
                priority: 'auto',
                attrs: alt_attrs
              -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if s.overlay_opacity > 0 and has_image -%}
          <span class="aurora-banner__overlay" aria-hidden="true"></span>
        {%- endif -%}

        {%- if has_content -%}
          <div class="aurora-banner__content{% if s.show_content_box %} aurora-banner__content--box{% endif %}">
            {%- if s.subheading != blank -%}
              <p class="aurora-banner__subheading">{{ s.subheading }}</p>
            {%- endif -%}
            {%- if s.heading != blank -%}
              <{{ s.heading_tag }} class="aurora-banner__heading">{{ heading_html }}</{{ s.heading_tag }}>
            {%- endif -%}
            {%- if s.text != blank -%}
              <div class="aurora-banner__text">{{ s.text }}</div>
            {%- endif -%}
            {%- if s.button_label_1 != blank or s.button_label_2 != blank -%}
              <div class="aurora-banner__buttons">
                {%- if s.button_label_1 != blank -%}
                  <a
                    class="aurora-banner__btn aurora-banner__btn--{{ s.button_style_1 }}"
                    {% if s.button_link_1 != blank %}href="{{ s.button_link_1 }}"{% else %}role="link" aria-disabled="true"{% endif %}
                  >
                    {{- s.button_label_1 -}}
                  </a>
                {%- endif -%}
                {%- if s.button_label_2 != blank -%}
                  <a
                    class="aurora-banner__btn aurora-banner__btn--{{ s.button_style_2 }}"
                    {% if s.button_link_2 != blank %}href="{{ s.button_link_2 }}"{% else %}role="link" aria-disabled="true"{% endif %}
                  >
                    {{- s.button_label_2 -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Aurora: Banner",
  "tag": "section",
  "class": "x-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "One banner with separate desktop and mobile artwork. Until artwork is uploaded, a placeholder shows the exact size to export."
    },
    {
      "type": "text",
      "id": "banner_label",
      "label": "Banner name (shown on placeholder)",
      "default": "Banner"
    },
    {
      "type": "header",
      "content": "Artwork"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image",
      "info": "Export at the desktop size below (default 1920 × 860 px). WebP or JPG, under 400 KB. Set a focal point in Files to control cropping."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Export at the mobile size below (default 900 × 1290 px). If empty, the desktop image is used on mobile."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner link",
      "info": "Makes the whole banner clickable"
    },
    {
      "type": "checkbox",
      "id": "use_collection_banner",
      "label": "Use each collection's own banner (collection pages)",
      "info": "Reads collection metafields custom.banner_desktop and custom.banner_mobile (type: file / image). Collections without them use the images above.",
      "default": false
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Banner height",
      "default": "fixed",
      "options": [
        { "value": "fixed", "label": "Use artwork size below (crops to fit)" },
        { "value": "adapt", "label": "Adapt to uploaded image" }
      ]
    },
    {
      "type": "header",
      "content": "Artwork size (px)"
    },
    {
      "type": "number",
      "id": "desktop_width",
      "label": "Desktop width",
      "default": 1920
    },
    {
      "type": "number",
      "id": "desktop_height",
      "label": "Desktop height",
      "default": 860
    },
    {
      "type": "number",
      "id": "mobile_width",
      "label": "Mobile width",
      "default": 900
    },
    {
      "type": "number",
      "id": "mobile_height",
      "label": "Mobile height",
      "default": 1290
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show size placeholder on the storefront when no image is set",
      "info": "Always visible in the theme editor. Turn off before publishing if artwork isn't ready.",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder_note",
      "label": "Placeholder note",
      "info": "Brief for the designer, e.g. the angle or offer for this banner"
    },
    {
      "type": "header",
      "content": "Text over the banner"
    },
    {
      "type": "paragraph",
      "content": "Leave empty if the text is already part of the artwork."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap words in [brackets] to highlight them in the accent colour"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "First button label"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link"
    },
    {
      "type": "select",
      "id": "button_style_1",
      "label": "First button style",
      "default": "solid",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" },
        { "value": "underline", "label": "Text link" }
      ]
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "Second button style",
      "default": "outline",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" },
        { "value": "underline", "label": "Text link" }
      ]
    },
    {
      "type": "header",
      "content": "Text position"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Position (desktop)",
      "default": "middle-left",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment (desktop)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Text width (desktop)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "mobile_content_layout",
      "label": "Mobile text placement",
      "default": "overlay",
      "options": [
        { "value": "overlay", "label": "On the image" },
        { "value": "below", "label": "Below the image" }
      ]
    },
    {
      "type": "select",
      "id": "content_position_mobile",
      "label": "Position (mobile)",
      "default": "bottom",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "visible_if": "{{ section.settings.mobile_content_layout == 'overlay' }}"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Text alignment (mobile)",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_content_box",
      "label": "Show a background box behind the text",
      "default": false
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Highlight / subheading",
      "default": "#D9B866"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#236A40"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "content_box_color",
      "label": "Text box background",
      "default": "#1F3B2D"
    },
    {
      "type": "range",
      "id": "content_box_opacity",
      "label": "Text box opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "color",
      "id": "banner_background",
      "label": "Banner background",
      "info": "Shown behind the placeholder or while the image loads",
      "default": "#EAF3E7"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection_art",
      "name": "Collection artwork",
      "settings": [
        { "type": "paragraph", "content": "Used when \"Use collection banner\" is on. Collection metafields (custom.banner_desktop / banner_mobile) still win when they are filled." },
        { "type": "text", "id": "title", "label": "Name (for your reference)", "default": "Category banner" },
        { "type": "collection_list", "id": "collections", "label": "Show on these collections", "limit": 25 },
        { "type": "text", "id": "url_match", "label": "Also show for filtered views", "info": "Matches the filter in the page address, e.g. type=sticks or pack=6,12 (shown when every selected value is in this list). Use & to require several filters." },
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image", "info": "1920 × 600 px. Overrides the theme file below." },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "900 × 600 px" },
        { "type": "text", "id": "desktop_asset", "label": "Desktop theme file", "info": "File name in the theme's assets folder, used when no image is picked" },
        { "type": "text", "id": "mobile_asset", "label": "Mobile theme file" },
        { "type": "text", "id": "alt", "label": "Image description (alt text)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurora: Banner",
      "category": "Aurora"
    }
  ]
}
{% endschema %}
