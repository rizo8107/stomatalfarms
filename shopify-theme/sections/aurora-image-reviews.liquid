{%- liquid
  assign s = section.settings
  assign image_count = 0
  for block in section.blocks
    if block.settings.image != blank
      assign image_count = image_count | plus: 1
    endif
  endfor
-%}
{%- if image_count > 0 or request.design_mode or s.show_placeholder -%}
<section
  class="aurora-section aurora-reviews aurora-reviews--{{ s.layout }}"
  id="aurora-reviews-{{ section.id }}"
  style="{% render 'aurora-section-vars', s: s %}"
>
  {%- if s.heading != blank or s.text != blank -%}
    <div class="aurora-section__header aurora-section__header--{{ s.heading_alignment }}">
      {%- if s.heading != blank -%}
        <h2 class="aurora-section__heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p>{{ s.text }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="aurora-reviews__track{% unless s.full_width %} page-width{% endunless %}">
    {%- for block in section.blocks -%}
      {%- if block.settings.image != blank -%}
        <button
          type="button"
          class="aurora-reviews__item"
          data-aurora-lightbox="aurora-lightbox-{{ section.id }}"
          data-full="{{ block.settings.image | image_url: width: 1400 }}"
          data-alt="{{ block.settings.image.alt | default: block.settings.caption | escape }}"
          {{ block.shopify_attributes }}
        >
          {{
            block.settings.image
            | image_url: width: 560
            | image_tag: loading: 'lazy', widths: '280, 420, 560', sizes: '(min-width: 768px) 280px, 72vw', alt: block.settings.caption
          }}
          {%- if block.settings.caption != blank and s.show_captions -%}
            <span class="aurora-reviews__caption">{{ block.settings.caption }}</span>
          {%- endif -%}
        </button>
      {%- elsif request.design_mode or s.show_placeholder -%}
        <div class="aurora-reviews__item is-placeholder" {{ block.shopify_attributes }}>
          <div class="aurora-placeholder" style="aspect-ratio: 9 / 16;">
            {{ 'image' | placeholder_svg_tag: 'aurora-placeholder__svg' }}
            <span class="aurora-placeholder__label"><strong>WhatsApp screenshot</strong>1080 × 1920 px (9:16)</span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if s.button_label != blank and s.button_link != blank -%}
    <p class="aurora-section__cta aurora-section__header--{{ s.heading_alignment }}">
      <a class="aurora-section__button" href="{{ s.button_link }}">{{ s.button_label }}</a>
    </p>
  {%- endif -%}

  <dialog class="aurora-lightbox" id="aurora-lightbox-{{ section.id }}">
    <img alt="" width="1200" height="1600">
    <button type="button" aria-label="Close">×</button>
  </dialog>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Aurora: WhatsApp reviews",
  "tag": "div",
  "class": "x-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Straight from our customers' WhatsApp"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subheading",
      "default": "Real messages from families who light Aurora every day."
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show placeholders while empty",
      "info": "Lets the team see where reviews go on the preview. Turn off before publishing if no reviews are added.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_captions",
      "label": "Show captions",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "slider",
      "options": [
        { "value": "slider", "label": "Swipe slider" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Screenshots per row (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Screenshots per row (mobile)",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "paragraph",
      "content": "Leave a colour transparent to use the theme colour."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "screenshot",
      "name": "Screenshot",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Screenshot",
          "info": "Recommended 1080 × 1920 px (phone screenshot). Hide phone numbers before uploading."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "e.g. customer first name and city"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurora: WhatsApp reviews",
      "category": "Aurora",
      "blocks": [
        { "type": "screenshot" },
        { "type": "screenshot" },
        { "type": "screenshot" },
        { "type": "screenshot" }
      ]
    }
  ]
}
{% endschema %}
