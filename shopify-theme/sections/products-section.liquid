{%- liquid
  assign products_collection = collections[section.settings.collection]
  if products_collection == blank
    assign products_collection = collections.all
  endif
-%}

<section id="products" class="py-14 md:py-20 px-4 bg-[#fffbf5] relative overflow-hidden">
  <div class="absolute top-0 left-0 w-full h-20 bg-gradient-to-b from-[#f9f6f0] to-transparent"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="mb-10 md:mb-14 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div>
        <p class="text-[10px] font-black uppercase tracking-[0.25em] text-[#4f7a2e] mb-2.5 flex items-center gap-2">
          <span class="w-6 h-px bg-[#4f7a2e]/40"></span>
          {{ section.settings.eyebrow }}
        </p>
        <h2
          class="text-4xl md:text-5xl text-[#2a3625] leading-tight tracking-tight"
          style="font-family: 'Cormorant Garamond', serif; font-weight: 500;"
        >
          {{ section.settings.heading }}
        </h2>
      </div>

      <a
        href="{{ routes.collections_url }}"
        class="w-fit px-8 py-3.5 rounded-full text-[10px] font-black uppercase tracking-[0.15em] text-white shadow-lg transition-all hover:opacity-90 active:scale-95"
        style="background: linear-gradient(135deg, #2e4e18, #4f7a2e);"
      >
        Explore Products →
      </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
      {%- for product in products_collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <div class="col-span-full text-center py-20 px-4">
          <div class="max-w-md mx-auto">
            <h3 class="font-display text-2xl text-foreground mb-3">No products yet</h3>
            <p class="text-muted-foreground">
              Products will appear here once added to your Shopify store.
            </p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Products section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Best Sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Most Loved Items"
    }
  ],
  "presets": [{ "name": "Products section" }]
}
{% endschema %}
