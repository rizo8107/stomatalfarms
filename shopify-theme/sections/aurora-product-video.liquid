{%- comment -%}
  Aurora: product video. Each block is one video; the section shows only the videos that
  belong to the current product.
  - Products tagged aurora-type:<x> show the blocks whose "Product type" is <x>.
  - Other products (combos, gift sets, starter packs) show every block whose keywords
    appear in the product title, type or tags.
  Videos load only when tapped (posters first), so the page stays fast.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign aurora_type = ''
  for tag in product.tags
    if tag contains 'aurora-type:'
      assign aurora_type = tag | remove: 'aurora-type:' | strip | downcase
      break
    endif
  endfor
  assign single_types = s.single_types | downcase | remove: ' ' | split: ','
  assign tag_text = product.tags | join: ' '
  assign haystack = product.title | append: ' ' | append: product.type | append: ' ' | append: tag_text | downcase

  assign shown_ids = ''
  for block in section.blocks
    assign b = block.settings
    if b.video_url == blank
      continue
    endif
    assign match = false
    if s.show_all
      assign match = true
    elsif single_types contains aurora_type and aurora_type != ''
      if b.product_type == aurora_type
        assign match = true
      endif
    else
      assign words = b.keywords | downcase | split: ','
      for word in words
        assign w = word | strip
        if w != blank and haystack contains w
          assign match = true
          break
        endif
      endfor
    endif
    if match
      assign shown_ids = shown_ids | append: block.id | append: ','
    endif
  endfor
  assign shown = shown_ids | split: ','
-%}
{%- if shown.size > 0 -%}
<section
  class="aurora-section aurora-pvideo{% if shown.size > 1 %} aurora-pvideo--multi{% endif %}"
  style="{% render 'aurora-section-vars', s: s %}"
>
  <div class="aurora-pvideo__inner page-width">
    {%- if s.eyebrow != blank or s.heading != blank or s.text != blank -%}
      <div class="aurora-pvideo__head">
        {%- if s.eyebrow != blank -%}<p class="aurora-pvideo__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}
          {%- render 'heading-highlight',
            headingId: section.id,
            heading: s.heading,
            highlight_type: 'font_highlight',
            heading_tag: 'h2',
            class: 'aurora-section__heading'
          -%}
        {%- endif -%}
        {%- if s.text != blank -%}<p class="aurora-pvideo__text">{{ s.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="aurora-pvideo__grid">
      {%- for block in section.blocks -%}
        {%- unless shown contains block.id -%}{%- continue -%}{%- endunless -%}
        {%- liquid
          assign b = block.settings
          if b.poster != blank
            assign poster = b.poster | image_url: width: 900
          elsif b.poster_asset != blank
            assign poster = b.poster_asset | asset_url
          else
            assign poster = ''
          endif
        -%}
        <figure class="aurora-pvideo__item" {{ block.shopify_attributes }}>
          <div class="aurora-pvideo__frame" style="--pv-ratio: {{ b.ratio | default: '1 / 1' }};">
            <video
              class="aurora-pvideo__video"
              data-aurora-video-src="{{ b.video_url | escape }}"
              {% if poster != '' %}poster="{{ poster }}"{% endif %}
              playsinline
              preload="none"
              {% if b.loop %}loop{% endif %}
              aria-label="{{ b.title | default: s.heading | escape }}"
            ></video>
            <button type="button" class="aurora-pvideo__play" data-aurora-video-play aria-label="{{ s.play_label | escape }}: {{ b.title | escape }}">
              <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
            </button>
            {%- if b.badge != blank -%}<span class="aurora-pvideo__badge">{{ b.badge }}</span>{%- endif -%}
          </div>
          {%- if b.title != blank or b.caption != blank -%}
            <figcaption class="aurora-pvideo__caption">
              {%- if b.title != blank -%}<strong>{{ b.title }}</strong>{%- endif -%}
              {%- if b.caption != blank -%}<span>{{ b.caption }}</span>{%- endif -%}
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Aurora: Product video",
  "tag": "div",
  "class": "x-section",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "Shows only the videos that match the product. Products tagged aurora-type:sticks get the Sticks video, aurora-type:cups the Cups video; combos and gift sets get every video whose keywords appear in their title or tags." },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Watch it burn" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap a word in [brackets] to highlight it", "default": "How to light it [right]" },
    { "type": "text", "id": "text", "label": "Text", "default": "Light it for about 20 seconds, wait for the amber glow, then enjoy." },
    { "type": "text", "id": "play_label", "label": "Play button label (screen readers)", "default": "Play video" },
    { "type": "text", "id": "single_types", "label": "Single-format product types", "info": "aurora-type tag values that should only show their own video", "default": "sticks, cups" },
    { "type": "checkbox", "id": "show_all", "label": "Show every video on every product", "default": false },
    { "type": "header", "content": "Design" },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 18, "max": 60, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 16, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "card_radius", "label": "Video corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "accent_color", "label": "Accent (small heading, play button)", "default": "rgba(0,0,0,0)" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "text", "id": "video_url", "label": "Video file URL (.mp4)", "info": "Upload in Content › Files, then paste the link here" },
        { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Shown before the video plays. Square works best." },
        { "type": "text", "id": "poster_asset", "label": "Fallback poster (theme file)", "info": "Used when no poster image is picked" },
        { "type": "select", "id": "product_type", "label": "Product type", "default": "sticks",
          "options": [ { "value": "sticks", "label": "Incense sticks" }, { "value": "cups", "label": "Incense cups" }, { "value": "other", "label": "Other (keywords only)" } ] },
        { "type": "text", "id": "keywords", "label": "Also show for products containing", "info": "Comma separated words matched against the title and tags, used for combos and gift sets", "default": "stick" },
        { "type": "select", "id": "ratio", "label": "Shape", "default": "1 / 1",
          "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait 4:5" }, { "value": "9 / 16", "label": "Reel 9:16" }, { "value": "16 / 9", "label": "Landscape 16:9" } ] },
        { "type": "checkbox", "id": "loop", "label": "Loop", "default": false },
        { "type": "text", "id": "badge", "label": "Corner label", "default": "Incense sticks" },
        { "type": "text", "id": "title", "label": "Caption title", "default": "Lighting Aurora incense sticks" },
        { "type": "text", "id": "caption", "label": "Caption text" }
      ]
    }
  ],
  "presets": [ { "name": "Aurora: Product video", "category": "Aurora", "blocks": [ { "type": "video" } ] } ]
}
{% endschema %}
