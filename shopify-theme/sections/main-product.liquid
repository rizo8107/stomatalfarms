{%- comment -%}
  Product detail page, matching the standard (non-Arka) layout of
  src/pages/ProductDetail.tsx.

  Content comes from the product's `custom` namespace metafields — the same keys
  the React app queried through the Storefront API — with the description used as
  the overview. Add to Cart posts through the native Shopify product form, so it
  works without the Phase 2 cart drawer.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  assign combo_includes = product.metafields.custom.combo_includes.value
  assign ingredients = product.metafields.custom.ingredients.value
  if product.metafields.custom.ingredients_list.value != blank
    assign ingredients = product.metafields.custom.ingredients_list.value
  endif
  assign how_to_use = product.metafields.custom.how_to_use.value
  assign details = product.metafields.custom.product_details.value
  assign key_highlights = product.metafields.custom.key_highlights.value
  assign nutritional_focus = product.metafields.custom.nutritional_focus.value
  assign custom_shipping_label = product.metafields.custom.custom_shipping_label.value

  assign overview = product.description
  if product.metafields.custom.custom_description.value != blank
    assign overview = product.metafields.custom.custom_description.value
  endif

  assign title_lower = product.title | downcase
  assign description_lower = product.description | downcase
  assign is_microgreens = false
  if title_lower contains 'microgreen' or title_lower contains 'leafy' or description_lower contains 'microgreen'
    assign is_microgreens = true
  endif

  assign has_discount = false
  if current_variant.compare_at_price > current_variant.price
    assign has_discount = true
    assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif
-%}

{%- capture spec_string -%}
  {%- if product.metafields.custom.net_quantity.value != blank %}Net Quantity: {{ product.metafields.custom.net_quantity.value }}
{% endif %}{% if product.metafields.custom.shelf_life.value != blank %}Shelf Life: {{ product.metafields.custom.shelf_life.value }}
{% endif %}{% if product.metafields.custom.storage.value != blank %}Storage: {{ product.metafields.custom.storage.value }}
{% endif %}{% if product.metafields.custom.fssai_license.value != blank %}FSSAI License: {{ product.metafields.custom.fssai_license.value }}
{% endif %}{% if product.metafields.custom.harvest_window.value != blank %}Harvest Window: {{ product.metafields.custom.harvest_window.value }}
{% endif %}{% if product.metafields.custom.delivery_region.value != blank %}Delivery Region: {{ product.metafields.custom.delivery_region.value }}
{% endif %}{% if product.metafields.custom.premium_quality.value != blank %}Quality: {{ product.metafields.custom.premium_quality.value }}{% endif -%}
{%- endcapture -%}

{%- capture safety_string -%}
  {%- if product.metafields.custom.safety_info.value != blank %}Safety Info: {{ product.metafields.custom.safety_info.value }}
{% endif %}{% if product.metafields.custom.ash_usage.value != blank %}Ash Usage: {{ product.metafields.custom.ash_usage.value }}
{% endif %}{% if product.metafields.custom.burning_time.value != blank %}Burning Time: {{ product.metafields.custom.burning_time.value }}{% endif -%}
{%- endcapture -%}

{%- assign spec_string = spec_string | strip -%}
{%- assign safety_string = safety_string | strip -%}
{%- comment -%}
  Appending with a real newline needs a capture: the {% liquid %} tag is
  line-based, so a string literal can't span lines inside it.
{%- endcomment -%}
{%- if spec_string != blank -%}
  {%- assign details_base = details -%}
  {%- capture details -%}
{% if details_base != blank %}{{ details_base }}
{% endif %}{{ spec_string }}
  {%- endcapture -%}
  {%- assign details = details | strip -%}
{%- endif -%}

{%- comment -%}
  Layout toggle. Precedence:
    1. the product's own `custom.product_layout` metafield ("arka" or "standard")
    2. the section's ARKA-style handle list
    3. the standard layout
  The metafield lets a merchant flip one product from the product page in admin;
  the handle list works with no metafield setup at all.
{%- endcomment -%}
{%- liquid
  assign layout_choice = product.metafields.custom.product_layout.value | default: '' | downcase | strip
  assign use_arka_layout = false

  if layout_choice == 'arka'
    assign use_arka_layout = true
  elsif layout_choice == 'standard' or layout_choice == 'normal'
    assign use_arka_layout = false
  else
    assign arka_handles = section.settings.arka_handles | newline_to_br | replace: '<br />', ',' | replace: '<br/>', ',' | split: ','
    for entry in arka_handles
      assign candidate = entry | strip | downcase
      if candidate != blank and candidate == product.handle
        assign use_arka_layout = true
        break
      endif
    endfor
  endif
-%}

<main class="pt-24 md:pt-32 pb-24 md:pb-12">
  <div class="container px-4 max-w-7xl mx-auto">
    <a
      href="{{ routes.collections_url }}"
      class="inline-flex items-center text-muted-foreground hover:text-foreground mb-6 md:mb-8 transition-colors text-sm"
    >
      {% render 'icon', name: 'chevron-left', class: 'h-4 w-4 mr-1' %}
      Back to shop
    </a>

    <product-detail>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-12 lg:gap-16">
        <div class="space-y-3 md:space-y-4 min-w-0 w-full">
          <div class="aspect-square rounded-xl md:rounded-2xl overflow-hidden bg-sage-light/30 border border-border shadow-sm p-2 md:p-4 flex items-center justify-center">
            {%- if product.featured_image -%}
              <img
                data-main-image
                src="{{ product.featured_image | image_url: width: 1200 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                class="w-full h-full object-contain"
              >
            {%- else -%}
              <div class="w-full h-full flex items-center justify-center text-muted-foreground">
                No image
              </div>
            {%- endif -%}
          </div>

          {%- if product.images.size > 1 -%}
            <div class="flex gap-2 md:gap-3 overflow-x-auto pb-2 scrollbar-hide w-full">
              {%- for image in product.images limit: 6 -%}
                <button
                  type="button"
                  data-thumbnail
                  data-full="{{ image | image_url: width: 1200 }}"
                  data-alt="{{ image.alt | default: product.title | escape }}"
                  class="w-16 h-16 md:w-20 md:h-20 rounded-lg md:rounded-xl flex-shrink-0 transition-all bg-white overflow-hidden border-2 {% if forloop.first %}border-[#5a8739] shadow-md{% else %}border-border hover:border-[#5a8739]/40{% endif %}"
                  aria-label="View image {{ forloop.index }}"
                >
                  <img
                    src="{{ image | image_url: width: 200 }}"
                    alt="{{ image.alt | default: product.title | escape }} {{ forloop.index }}"
                    width="80"
                    height="80"
                    loading="lazy"
                    class="w-full h-full object-contain p-1"
                  >
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- if use_arka_layout -%}
          {% render 'product-arka-panel',
            product: product,
            current_variant: current_variant,
            overview: overview,
            combo_includes: combo_includes,
            key_highlights: key_highlights,
            ingredients: ingredients,
            how_to_use: how_to_use,
            safety_string: safety_string,
            details: details
          %}
        {%- else -%}
        <div class="space-y-6 md:space-y-8 min-w-0 w-full">
          <div class="space-y-4">
            <div class="space-y-2">
              <div class="flex flex-wrap gap-2 mb-2">
                <span class="bg-[#5a8739]/10 text-[#5a8739] text-[10px] font-bold uppercase tracking-widest px-2 py-1 rounded-full border border-[#5a8739]/20">
                  Handcrafted
                </span>
                <span class="bg-sage-light/30 text-sage-dark text-[10px] font-bold uppercase tracking-widest px-2 py-1 rounded-full border border-border">
                  100% Natural
                </span>
              </div>
              <h1 class="font-serif text-2xl md:text-3xl lg:text-4xl text-foreground leading-[1.3] md:leading-tight break-words tracking-tight">
                {{ product.title }}
              </h1>
            </div>

            <div class="flex items-center gap-4">
              <div class="flex flex-col">
                <span data-price class="text-3xl md:text-4xl font-bold text-[#5a8739] tracking-tight">
                  ₹{{ current_variant.price | divided_by: 100.0 | round }}
                </span>
              </div>
              <div data-compare-wrap class="flex items-center gap-2 mt-1" {% unless has_discount %}hidden{% endunless %}>
                <span data-compare-price class="text-base text-muted-foreground line-through decoration-muted-foreground/50 decoration-2">
                  ₹{{ current_variant.compare_at_price | divided_by: 100.0 | round }}
                </span>
                <span data-discount-pct class="bg-[#cb6c4c] text-white text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full shadow-[0_4px_12px_rgba(203,108,76,0.4)] whitespace-nowrap">
                  {{ discount_pct }}% OFF
                </span>
              </div>
            </div>
          </div>

          {%- if overview != blank -%}
            <div class="space-y-6">
              <div class="relative group">
                <div class="absolute -left-4 top-0 bottom-0 w-1 bg-gradient-to-b from-[#5a8739] to-transparent opacity-40 group-hover:opacity-100 transition-opacity"></div>
                <div class="text-foreground/80 leading-[1.8] whitespace-pre-line text-[15px] font-medium italic pl-2 py-1 [&_p]:mb-5 [&_p:last-child]:mb-0">
                  {{ overview }}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- assign accordion_entries = 'key_highlights|Key Highlights|plus,combo_includes|This Combo Includes|leaf,ingredients|Ingredients & Aroma|shield,how_to_use|How to Use|award,nutritional_focus|Nutritional Focus|leaf,safety_string|Safety & Care|shield,details|Product Specifications|truck' | split: ',' -%}
          <product-accordion class="w-full space-y-3 block">
            {%- for entry in accordion_entries -%}
              {%- assign parts = entry | split: '|' -%}
              {%- case parts[0] -%}
                {%- when 'key_highlights' -%}{%- assign body = key_highlights -%}
                {%- when 'combo_includes' -%}{%- assign body = combo_includes -%}
                {%- when 'ingredients' -%}{%- assign body = ingredients -%}
                {%- when 'how_to_use' -%}{%- assign body = how_to_use -%}
                {%- when 'nutritional_focus' -%}{%- assign body = nutritional_focus -%}
                {%- when 'safety_string' -%}{%- assign body = safety_string -%}
                {%- when 'details' -%}{%- assign body = details -%}
              {%- endcase -%}

              {%- if body != blank -%}
                <div data-accordion-item class="border-b border-border/60 overflow-hidden">
                  <button
                    type="button"
                    data-accordion-trigger
                    aria-expanded="false"
                    class="w-full text-[17px] font-serif font-semibold py-6 hover:no-underline text-foreground group flex items-center justify-between gap-4"
                  >
                    <span class="flex items-center gap-4">
                      <span data-accordion-icon class="w-10 h-10 rounded-2xl bg-primary/5 flex items-center justify-center transition-all duration-500">
                        {% render 'icon', name: parts[2], class: 'w-5 h-5 text-current' %}
                      </span>
                      {{ parts[1] }}
                    </span>
                    <span data-accordion-chevron class="transition-transform duration-300">
                      {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
                    </span>
                  </button>
                  <div data-accordion-panel class="pb-8 pl-14 whitespace-pre-line text-muted-foreground text-[15px] leading-relaxed" hidden>
                    {{ body }}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </product-accordion>

          {%- if overview == blank and ingredients == blank and how_to_use == blank and details == blank -%}
            <p class="text-muted-foreground text-sm leading-relaxed">
              Premium handcrafted aromatic product made with natural ingredients and traditional herbs.
            </p>
          {%- endif -%}

          {%- form 'product', product, id: 'product-form', class: 'contents' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

            {%- if product.has_only_default_variant == false -%}
              <div class="space-y-4 pt-4 border-t border-border/50">
                {%- for option in product.options_with_values -%}
                  <div>
                    <label class="text-sm font-semibold text-foreground mb-3 block">{{ option.name }}</label>
                    <div class="flex flex-wrap gap-2">
                      {%- for value in option.values -%}
                        <button
                          type="button"
                          data-option-value
                          data-option-position="{{ option.position }}"
                          data-value="{{ value | escape }}"
                          class="px-5 py-2.5 rounded-lg border-2 text-sm font-medium transition-all {% if option.selected_value == value %}border-[#5a8739] bg-[#5a8739]/10 text-[#5a8739] shadow-sm{% else %}border-border hover:border-[#5a8739]/40 hover:bg-sage-light/20{% endif %}"
                          aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                        >
                          {{ value }}
                        </button>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="hidden md:flex items-center gap-4 pt-4">
              {%- unless is_microgreens -%}
                <div class="flex items-center border-2 border-border rounded-lg overflow-hidden">
                  <button type="button" data-qty-decrease class="inline-flex items-center justify-center h-12 w-12 rounded-none hover:bg-sage-light/30 transition-all duration-300" aria-label="Decrease quantity">
                    {% render 'icon', name: 'minus', class: 'h-4 w-4' %}
                  </button>
                  <input
                    type="number"
                    name="quantity"
                    data-qty-input
                    value="1"
                    min="1"
                    class="w-12 text-center font-semibold border-x-2 border-border h-12 bg-transparent focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                    aria-label="Quantity"
                  >
                  <button type="button" data-qty-increase class="inline-flex items-center justify-center h-12 w-12 rounded-none hover:bg-sage-light/30 transition-all duration-300" aria-label="Increase quantity">
                    {% render 'icon', name: 'plus', class: 'h-4 w-4' %}
                  </button>
                </div>
              {%- endunless -%}

              {%- if is_microgreens -%}
                <a
                  data-whatsapp-order
                  data-phone="{{ section.settings.whatsapp_number }}"
                  data-product-title="{{ product.title | escape }}"
                  href="#"
                  class="inline-flex items-center justify-center gap-2 rounded-md flex-1 bg-[#5a8739] hover:bg-[#5a8739]/90 text-white h-12 text-base font-semibold shadow-md hover:shadow-lg transition-all"
                >
                  {% if current_variant.available %}Order on WhatsApp{% else %}Out of Stock{% endif %}
                </a>
              {%- else -%}
                <button
                  type="submit"
                  data-add-to-cart
                  data-ajax-add
                  class="inline-flex items-center justify-center gap-2 rounded-md flex-1 bg-[#5a8739] hover:bg-[#5a8739]/90 text-white h-12 text-base font-semibold shadow-md hover:shadow-lg transition-all disabled:pointer-events-none disabled:opacity-50"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  {% render 'icon', name: 'shopping-cart', class: 'h-5 w-5 mr-2' %}
                  <span data-cta-label>{% if current_variant.available %}Add to Cart{% else %}Out of Stock{% endif %}</span>
                </button>
              {%- endif -%}
            </div>

            {%- comment -%} Mobile sticky bar, same form so it submits the same variant. {%- endcomment -%}
            <div class="md:hidden fixed bottom-0 left-0 right-0 bg-background border-t border-border p-3 z-40">
              <div class="flex items-center gap-3">
                {%- unless is_microgreens -%}
                  <div class="flex items-center gap-1.5 bg-muted rounded-lg p-1">
                    <button type="button" data-qty-decrease class="inline-flex items-center justify-center h-8 w-8 rounded-md transition-all duration-300" aria-label="Decrease quantity">
                      {% render 'icon', name: 'minus', class: 'h-3 w-3' %}
                    </button>
                    <span data-qty-display class="w-6 text-center text-sm font-medium">1</span>
                    <button type="button" data-qty-increase class="inline-flex items-center justify-center h-8 w-8 rounded-md transition-all duration-300" aria-label="Increase quantity">
                      {% render 'icon', name: 'plus', class: 'h-3 w-3' %}
                    </button>
                  </div>
                {%- endunless -%}

                {%- if is_microgreens -%}
                  <a
                    data-whatsapp-order
                    data-phone="{{ section.settings.whatsapp_number }}"
                    data-product-title="{{ product.title | escape }}"
                    href="#"
                    class="inline-flex items-center justify-center gap-2 rounded-md flex-1 bg-[#5a8739] hover:bg-[#5a8739]/90 text-white h-11 text-sm font-semibold"
                  >
                    {% if current_variant.available %}Order on WhatsApp{% else %}Out of Stock{% endif %}
                  </a>
                {%- else -%}
                  <button
                    type="submit"
                    data-ajax-add
                    class="inline-flex items-center justify-center gap-2 rounded-md flex-1 bg-[#5a8739] hover:bg-[#5a8739]/90 text-white h-11 text-sm font-semibold disabled:pointer-events-none disabled:opacity-50"
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    {% render 'icon', name: 'shopping-cart', class: 'h-4 w-4 mr-2' %}
                    {% if current_variant.available %}Add to Cart{% else %}Out of Stock{% endif %}
                  </button>
                {%- endif -%}
              </div>
            </div>
          {%- endform -%}

          {%- if is_microgreens -%}
            <div class="pt-6 border-t border-border">
              <div class="bg-[#5a8739]/10 border-2 border-[#5a8739] rounded-lg p-4">
                <div class="flex items-start gap-3">
                  <span class="h-8 w-8 flex-shrink-0 text-[#5a8739]">
                    {% render 'icon', name: 'truck', class: 'h-8 w-8' %}
                  </span>
                  <div>
                    <h4 class="font-semibold text-foreground mb-1 text-sm">
                      {{ custom_shipping_label | default: 'Fresh Harvest Delivery' }}
                    </h4>
                    <p class="text-xs text-muted-foreground leading-relaxed">
                      Microgreens require same-day harvest and doorstep delivery, so a standard delivery charge of ₹100 applies.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          {%- else -%}
            <div class="space-y-3 pt-6 border-t border-border">
              <div class="flex items-center gap-3 p-3.5 rounded-xl bg-[#fffbf5] border border-[#2e3f25]/10 text-xs text-[#2a3625]">
                <div class="w-8 h-8 rounded-lg bg-[#4f7a2e]/10 flex items-center justify-center text-[#4f7a2e] flex-shrink-0">
                  {% render 'icon', name: 'truck', class: 'w-4 h-4' %}
                </div>
                <div class="leading-snug">
                  <span class="font-bold text-[#2e4e18]">Free Shipping over ₹999</span>
                  <span class="text-[#6a7462]"> · ₹60 flat shipping below ₹999 · No minimum order</span>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="flex items-center gap-3 text-sm text-foreground bg-[#5a8739]/5 rounded-xl p-4 border border-[#5a8739]/10 shadow-sm">
                  {% render 'icon', name: 'leaf', class: 'h-6 w-6 text-[#5a8739] flex-shrink-0' %}
                  <span class="font-medium">100% Natural</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-foreground bg-[#5a8739]/5 rounded-xl p-4 border border-[#5a8739]/10 shadow-sm">
                  {% render 'icon', name: 'shield', class: 'h-6 w-6 text-[#5a8739] flex-shrink-0' %}
                  <span class="font-medium">Secure Payment</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-foreground bg-[#5a8739]/5 rounded-xl p-4 border border-[#5a8739]/10 shadow-sm">
                  {% render 'icon', name: 'award', class: 'h-6 w-6 text-[#5a8739] flex-shrink-0' %}
                  <span class="font-medium">Premium Quality</span>
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
        {%- endif -%}
      </div>

      {%- comment -%} Variant data drives client-side price/availability swapping. {%- endcomment -%}
      <script type="application/json" data-variant-data>
        [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id | json }},
              "options": {{ variant.options | json }},
              "available": {{ variant.available | json }},
              "price": {{ variant.price | divided_by: 100.0 | round | json }},
              "compareAtPrice": {% if variant.compare_at_price %}{{ variant.compare_at_price | divided_by: 100.0 | round | json }}{% else %}null{% endif %},
              "discountPct": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round | json }}{% else %}0{% endif %}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      </script>
    </product-detail>
  </div>

  {%- if section.settings.show_related -%}
    {%- assign related_collection = product.collections.first | default: collections.all -%}
    {%- assign related_count = 0 -%}
    <section class="py-14 md:py-20 px-4 bg-[#fffbf5] mt-12">
      <div class="max-w-7xl mx-auto">
        <div class="mb-8 md:mb-10">
          <p class="text-[10px] font-black uppercase tracking-[0.25em] text-[#4f7a2e] mb-2.5 flex items-center gap-2">
            <span class="w-6 h-px bg-[#4f7a2e]/40"></span>
            More from Aurora
          </p>
          <h2 class="text-3xl md:text-4xl text-[#2a3625] leading-tight tracking-tight" style="font-family: 'Cormorant Garamond', serif; font-weight: 500;">
            You may also like
          </h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
          {%- for related in related_collection.products limit: 12 -%}
            {%- if related.id != product.id and related_count < 4 -%}
              {%- assign related_count = related_count | plus: 1 -%}
              {% render 'product-card', product: related %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</main>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "textarea",
      "id": "arka_handles",
      "label": "ARKA-style product handles",
      "info": "One handle per line (or comma separated). These products render the ARKA panel instead of the standard layout. A product's own custom.product_layout metafield (\"arka\" or \"standard\") overrides this list.",
      "default": "arka-cow-dung-incense-cups"
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show related products",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "info": "Used for microgreens products, which order over WhatsApp rather than the cart.",
      "default": "916379033131"
    }
  ]
}
{% endschema %}
