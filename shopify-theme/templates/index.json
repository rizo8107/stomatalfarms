    "aurora_faq": {
      "type": "faq",
      "blocks": {
        "f1": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Which product should I start with?",
            "row_content": "<p>Our incense sticks are perfect for daily use, while cups offer a deeper, more therapeutic experience. If you're new, the combo packs are our most-loved starting point.</p>"
          }
        },
        "f2": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Does cow dung incense smell of dung?",
            "row_content": "<p>No. The cow dung is purified and solar-dried, so it is odourless. You only smell the herbs, resins and natural extracts.</p>"
          }
        },
        "f3": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Are these safe for children and elders?",
            "row_content": "<p>Yes. Every Aurora product is made from natural, chemical-free ingredients with no synthetic binders.</p>"
          }
        },
        "f4": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How long does each product last?",
            "row_content": "<p>Sticks burn for about 45 minutes and cups for about 25–30 minutes. The aroma lingers for hours after.</p>"
          }
        },
        "f5": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "What are your shipping rates?",
            "row_content": "<p>There is no minimum order. Shipping is FREE on orders above ₹999 across India; a flat ₹60 applies below ₹999.</p>"
          }
        },
        "f6": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "What if my order arrives damaged?",
            "row_content": "<p>Message us on WhatsApp with a photo or unboxing video within 24 hours of delivery and we will replace it free.</p>"
          }
        }
      },
