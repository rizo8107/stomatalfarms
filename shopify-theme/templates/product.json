    "aurora_faq": {
      "type": "faq",
      "blocks": {
        "f1": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Does cow dung incense smell of dung?",
            "row_content": "<p>No. The cow dung is purified and solar-dried, so it is odourless. You only smell the herbs, resins and natural extracts.</p>"
          }
        },
        "f2": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Are these safe for children, elders and pets?",
            "row_content": "<p>Yes. Aurora is made with natural, chemical-free ingredients and no synthetic binders. As with any incense, burn it in a ventilated space.</p>"
          }
        },
        "f3": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How long does each stick or cup burn?",
            "row_content": "<p>Sticks burn for about 45 minutes; cups for about 25–30 minutes. The aroma lingers for hours.</p>"
          }
        },
        "f4": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How do I light an incense cup?",
            "row_content": "<p>Light all sides of the rim for 20 seconds, keep the flame for 20 more seconds, then let it glow amber. Sprinkle the herbal powder on the ember for a richer aroma.</p>"
          }
        },
        "f5": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Which one should I start with?",
            "row_content": "<p>Sticks are perfect for daily use; cups give a deeper, temple-like aroma. If you are new, a combo pack lets you try both.</p>"
          }
        },
        "f6": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "What can I do with the leftover ash?",
            "row_content": "<p>Use it as vibhuti, mix it into plant soil as a natural fertiliser, or use it to scrub utensils.</p>"
          }
        },
        "f7": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "What are the shipping charges and delivery time?",
            "row_content": "<p>Orders ship in 3–5 working days. Shipping is FREE above ₹999; a flat ₹60 applies below that.</p>"
          }
        },
        "f8": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "What if my order arrives damaged?",
            "row_content": "<p>Send us a photo or unboxing video on WhatsApp within 24 hours of delivery and we will replace it free.</p>"
          }
        }
      },
