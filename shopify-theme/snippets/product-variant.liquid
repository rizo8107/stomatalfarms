{% liquid
  if picker_type == 'adapt'
    assign picker_type = settings.quick_add_picker_type
    assign max_swatch = settings.max_swatch
  endif
%}
<div
  id="variant-update-{{ section.id }}"
  class="variant-update-{{ section.id }} advanced-variant-cards"
  x-init="initFirstAvailableVariant($el)"
>
  <style>
    /* =========================================================
       COMPACT VARIANT CARDS
       Amazon-style / Clean / Premium
       ========================================================= */

    .advanced-variant-cards {
      width: 100%;
    }


    /* =========================================================
       VARIANT FIELDSET
       ========================================================= */

    .advanced-variant-cards .product-form__input {
      width: 100%;
      display: block;
      margin: 0;
      padding-left: 0;
    }


    /* =========================================================
       GRID
       ========================================================= */

    .advanced-variant-cards .advanced-variant-grid {
      display: grid !important;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      width: 100%;
    }


    /* =========================================================
       HIDE ORIGINAL RADIO
       ========================================================= */

    .advanced-variant-cards .advanced-variant-input {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      opacity: 0 !important;
      pointer-events: none !important;
      margin: 0 !important;
    }


    /* =========================================================
       CARD
       ========================================================= */

    .advanced-variant-cards .advanced-variant-card {
      position: relative;

      display: flex;
      flex-direction: column;

      width: 100%;
      min-width: 0;

      padding: 6px;

      background: #ffffff;

      border: 1px solid #dedfd8;
      border-radius: 11px;

      cursor: pointer;

      overflow: hidden;

      transition:
        border-color 0.18s ease,
        box-shadow 0.18s ease,
        transform 0.18s ease,
        background 0.18s ease;
    }


    /* =========================================================
       HOVER
       ========================================================= */

    .advanced-variant-cards .advanced-variant-card:hover {
      border-color: #9baa78;

      box-shadow:
        0 4px 12px rgba(40, 55, 25, 0.08);

      transform: translateY(-1px);
    }


    /* =========================================================
       SELECTED
       ========================================================= */

    .advanced-variant-cards
    .advanced-variant-input:checked
    + .advanced-variant-card {
      border: 2px solid #718d3b;

      background: #fbfcf7;

      box-shadow:
        0 4px 14px rgba(113, 141, 59, 0.14);
    }


    /* =========================================================
       VARIANT IMAGE
       ========================================================= */

    .advanced-variant-cards .advanced-variant-image {
      display: block;

      width: 100%;
      height: auto;

      aspect-ratio: 1 / 1;

      object-fit: cover;

      border-radius: 7px;

      background: #f5f5ef;
    }


    /* =========================================================
       CARD CONTENT
       ========================================================= */

    .advanced-variant-cards .advanced-variant-info {
      width: 100%;

      padding: 7px 2px 3px;

      text-align: center;
    }


    /* =========================================================
       VARIANT NAME
       ========================================================= */

    .advanced-variant-cards .advanced-variant-name {
      display: block;

      width: 100%;

      color: #20251d;

      font-size: 13px;
      line-height: 1.25;
      font-weight: 600;

      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }


    /* =========================================================
       PRICE ROW
       ========================================================= */

    .advanced-variant-cards .advanced-variant-price {
      display: flex;

      justify-content: center;
      align-items: center;

      flex-wrap: wrap;

      gap: 4px;

      margin-top: 3px;
    }


    /* =========================================================
       CURRENT PRICE
       ========================================================= */

    .advanced-variant-cards .advanced-price {
      color: #1d2419;

      font-size: 14px;
      line-height: 1.2;

      font-weight: 700;
    }


    /* =========================================================
       COMPARE PRICE
       ========================================================= */

    .advanced-variant-cards .advanced-compare-price {
      color: #999;

      font-size: 10px;
      line-height: 1.2;

      text-decoration: line-through;
    }


    /* =========================================================
       SELECTED CHECK
       ========================================================= */

    .advanced-variant-cards .advanced-variant-check {
      position: absolute;

      top: 6px;
      right: 6px;

      display: flex;

      align-items: center;
      justify-content: center;

      width: 20px;
      height: 20px;

      border-radius: 50%;

      background: #718d3b;

      color: #ffffff;

      font-size: 10px;
      font-weight: 700;

      opacity: 0;

      transform: scale(0.7);

      box-shadow:
        0 2px 6px rgba(0, 0, 0, 0.15);

      transition:
        opacity 0.18s ease,
        transform 0.18s ease;

      z-index: 5;
    }


    /* =========================================================
       SHOW CHECK WHEN SELECTED
       ========================================================= */

    .advanced-variant-cards
    .advanced-variant-input:checked
    + .advanced-variant-card
    .advanced-variant-check {
      opacity: 1;

      transform: scale(1);
    }


    /* =========================================================
       SOLD OUT
       ========================================================= */

    .advanced-variant-cards .advanced-variant-soldout {
      position: absolute;

      top: 6px;
      left: 6px;

      padding: 4px 6px;

      border-radius: 5px;

      background: rgba(25, 25, 25, 0.82);

      color: #ffffff;

      font-size: 8px;
      line-height: 1;

      font-weight: 600;

      z-index: 4;
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @media (min-width: 600px) and (max-width: 989px) {

      .advanced-variant-cards .advanced-variant-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));

        gap: 10px;
      }

      .advanced-variant-cards .advanced-variant-card {
        padding: 6px;

        border-radius: 11px;
      }

      .advanced-variant-cards .advanced-variant-info {
        padding: 7px 3px 3px;
      }

      .advanced-variant-cards .advanced-variant-name {
        font-size: 13px;
      }

      .advanced-variant-cards .advanced-price {
        font-size: 14px;
      }
    }


    /* =========================================================
       DESKTOP
       ========================================================= */

    @media (min-width: 990px) {

      .advanced-variant-cards .advanced-variant-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));

        gap: 10px;
      }

      .advanced-variant-cards .advanced-variant-card {
        padding: 6px;

        border-radius: 11px;
      }

      .advanced-variant-cards .advanced-variant-image {
        border-radius: 7px;
      }

      .advanced-variant-cards .advanced-variant-info {
        padding: 7px 3px 3px;
      }

      .advanced-variant-cards .advanced-variant-name {
        font-size: 13px;
      }

      .advanced-variant-cards .advanced-price {
        font-size: 14px;
      }

      .advanced-variant-cards .advanced-compare-price {
        font-size: 10px;
      }
    }


    /* =========================================================
       MOBILE
       3 CARDS PER ROW
       ========================================================= */

    @media (max-width: 599px) {

      .advanced-variant-cards .advanced-variant-grid {
        display: grid !important;

        grid-template-columns:
          repeat(3, minmax(0, 1fr));

        gap: 7px;

        width: 100%;
      }


      /* CARD */

      .advanced-variant-cards .advanced-variant-card {
        padding: 4px;

        border: 1px solid #dedfd8;

        border-radius: 9px;
      }


      /* SELECTED CARD */

      .advanced-variant-cards
      .advanced-variant-input:checked
      + .advanced-variant-card {

        border: 2px solid #718d3b;

        background: #fbfcf7;

        box-shadow:
          0 3px 10px rgba(113, 141, 59, 0.14);
      }


      /* IMAGE */

      .advanced-variant-cards .advanced-variant-image {

        width: 100%;

        aspect-ratio: 1 / 1;

        object-fit: cover;

        border-radius: 6px;
      }


      /* CONTENT */

      .advanced-variant-cards .advanced-variant-info {

        padding:
          5px
          2px
          3px;

        text-align: center;
      }


      /* NAME */

      .advanced-variant-cards .advanced-variant-name {

        font-size: 11px;

        line-height: 1.25;

        font-weight: 600;
      }


      /* PRICE ROW */

      .advanced-variant-cards .advanced-variant-price {

        margin-top: 3px;

        gap: 3px;
      }


      /* PRICE */

      .advanced-variant-cards .advanced-price {

        font-size: 12px;

        line-height: 1.2;

        font-weight: 700;
      }


      /* OLD PRICE */

      .advanced-variant-cards .advanced-compare-price {

        font-size: 9px;

        line-height: 1.2;
      }


      /* CHECK */

      .advanced-variant-cards .advanced-variant-check {

        top: 4px;

        right: 4px;

        width: 18px;

        height: 18px;

        font-size: 9px;
      }


      /* SOLD OUT */

      .advanced-variant-cards .advanced-variant-soldout {

        top: 4px;

        left: 4px;

        padding:
          3px
          5px;

        font-size: 8px;

        border-radius: 4px;
      }


      /* REMOVE HOVER MOVEMENT ON MOBILE */

      .advanced-variant-cards
      .advanced-variant-card:hover {

        transform: none;

        box-shadow:
          0 2px 8px rgba(40, 55, 25, 0.06);
      }
    }


    /* =========================================================
       VERY SMALL PHONES
       ========================================================= */

    @media (max-width: 360px) {

      .advanced-variant-cards .advanced-variant-grid {

        grid-template-columns:
          repeat(3, minmax(0, 1fr));

        gap: 5px;
      }


      .advanced-variant-cards .advanced-variant-card {

        padding: 3px;

        border-radius: 8px;
      }


      .advanced-variant-cards .advanced-variant-image {

        border-radius: 5px;
      }


      .advanced-variant-cards .advanced-variant-info {

        padding:
          4px
          1px
          2px;
      }


      .advanced-variant-cards .advanced-variant-name {

        font-size: 10px;
      }


      .advanced-variant-cards .advanced-price {

        font-size: 11px;
      }


      .advanced-variant-cards .advanced-compare-price {

        font-size: 8px;
      }


      .advanced-variant-cards .advanced-variant-check {

        top: 3px;

        right: 3px;

        width: 16px;

        height: 16px;

        font-size: 8px;
      }
    }
  </style>

  <script type="application/json" data-selected-variant>
    {{ product.selected_or_first_available_variant | json }}
  </script>
  {%- for option in product.options_with_values -%}
    {%- assign option_index = forloop.index | minus: 1 -%}
    {%- if picker_type == 'button' and option.values.size <= max_swatch or max_swatch == 0 -%}
      <fieldset
        id="Option-{{ section.id }}-{{ forloop.index0 }}"
        class="product-form__input advanced-variant-grid pl-0 pb-5 quick-view:pb-2"
        data-option-name="{{ option.name | handle }}"
        data-option-index="{{ forloop.index | minus: 1 }}"
      >
        {% if block.settings.show_variant_option %}
          <legend class="font-medium">
            {{ option.name -}}
            {%- if block.settings.enable_color_swatches
              and settings.color_option_name contains option.name
              and product.selected_variant
              or settings.default_select_available_variant
            -%}
              :
              <span>{{- option.selected_value -}}</span>
            {% endif %}
          </legend>
        {% endif %}
        {% render 'product-variant-options',
          product: product,
          block: block,
          option: option,
          option_index: option_index,
          product_form_id: product_form_id,
          input_type: 'radio',
          enable_color_swatches: enable_color_swatches,
          rounded_corner_option: rounded_corner_image,
          show_media_with_variant_selected: show_media_with_variant_selected,
          media_with_option: media_with_option,
          swatch_size: swatch_size
        %}
      </fieldset>
    {%- else -%}
      <div
        data-option-name="{{ option.name | handle }}"
        data-option-index="{{ forloop.index | minus: 1 }}"
      >
        {%- if block.settings.show_variant_option -%}
          <label class="mt-1 mb-1 font-medium" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option.name }}
          </label>
        {%- endif -%}
        <div class="select relative outline-none neone">
          <select
            id="Option-{{ section.id }}-{{ forloop.index0 }}"
            class="product-form__input w-full pt-2.5 pb-2.5 pl-5 pr-8 rtl:pr-5 rtl:pl-8 mt-2 mb-2 bg-transparent focus:border-current border appearance-none outline-none border-solid focus-visible:outline-none cursor-pointer{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
            name="{{ option.name }}"
            form="{{ product_form_id }}"
          >
            {% render 'product-variant-options',
              product: product,
              option: option,
              option_index: option_index,
              product_form_id: product_form_id,
              input_type: 'select',
              enable_color_swatches: block.settings.enable_color_swatches,
              swatch_size: swatch_size
            %}
          </select>
          <div
            x-cloak
            x-show="loadingEls === 'Option-{{ section.id }}-{{ forloop.index0 }}'"
            class="w-4 h-4 absolute top-1/2 right-3 rtl:right-auto rtl:left-3 -translate-y-1/2"
          >
            <div class="animate-spin w-4 h-4 border-loading border-[rgba(var(--colors-text))]"></div>
          </div>
          <span
            x-cloak
            x-show="loadingEls !== 'Option-{{ section.id }}-{{ forloop.index0 }}'"
            class="absolute top-1/2 right-4 rtl:right-auto rtl:left-4 -translate-y-1/2 w-2.5 inline-block pointer-events-none"
          >
            {% render 'icon-alls', icon: 'icon-caret' %}
          </span>
        </div>
      </div>
    {% endif %}
  {%- endfor -%}
</div>
