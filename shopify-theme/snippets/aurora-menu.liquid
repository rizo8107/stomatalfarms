{%- comment -%}
  Aurora: drill-down menu built from Theme settings › Aurora: Menu (one outline for
  desktop dropdowns and the mobile drawer). Native <details> on mobile, CSS
  hover/focus dropdowns on desktop – no JS needed.

  Outline format, one item per line:  Label | /link
    "-" prefix = sub-category, "--" prefix = third level.

  Accepts:
  - mode: {String} 'desktop' | 'mobile'
{%- endcomment -%}
{%- liquid
  assign raw_lines = settings.aurora_menu_outline | newline_to_br | split: '<br />'
  assign levels = ''
  assign clean = ''
  for raw in raw_lines
    assign t = raw | strip
    if t == blank
      continue
    endif
    assign lvl = 0
    assign first2 = t | slice: 0, 2
    assign first1 = t | slice: 0, 1
    if first2 == '--'
      assign lvl = 2
    elsif first1 == '-'
      assign lvl = 1
    endif
    assign levels = levels | append: lvl | append: ','
    assign clean = clean | append: t | append: '§§'
  endfor
  assign level_list = levels | split: ','
  assign item_list = clean | split: '§§'
  assign all_label = settings.aurora_menu_all_label | default: 'Shop all'
  assign open0 = false
  assign open1 = false
  assign chevron = '<svg class="aurora-menu-chev" viewBox="0 0 20 20" width="12" height="12" aria-hidden="true"><path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
-%}
{%- for item in item_list -%}
  {%- liquid
    assign level = level_list[forloop.index0] | plus: 0
    assign next_level = level_list[forloop.index] | plus: 0
    assign has_children = false
    if next_level > level
      assign has_children = true
    endif
    assign body = item
    if level == 2
      assign body = item | remove_first: '--'
    elsif level == 1
      assign body = item | remove_first: '-'
    endif
    assign parts = body | split: '|'
    assign label = parts[0] | strip | escape
    assign url = ''
    if parts.size > 1
      assign url = parts[1] | strip
    endif
  -%}
  {%- if mode == 'mobile' -%}
    {%- if level <= 1 and open1 -%}</div></details>{%- assign open1 = false -%}{%- endif -%}
    {%- if level == 0 and open0 -%}</div></details>{%- assign open0 = false -%}{%- endif -%}
    {%- if level == 0 and has_children -%}
      <details class="aurora-mnav__group">
        <summary class="aurora-mnav__summary aurora-mnav__top">{{ label }}{{ chevron }}</summary>
        <div class="aurora-mnav__panel">
          {%- if url != blank -%}<a class="aurora-mnav__all" href="{{ url }}">{{ all_label }} {{ label }}</a>{%- endif -%}
      {%- assign open0 = true -%}
    {%- elsif level == 0 -%}
      <a class="aurora-mnav__link aurora-mnav__top" href="{{ url | default: '#' }}">{{ label }}</a>
    {%- elsif level == 1 and has_children -%}
      <details class="aurora-mnav__sub">
        <summary class="aurora-mnav__summary">{{ label }}{{ chevron }}</summary>
        <div class="aurora-mnav__panel aurora-mnav__panel--l2">
          {%- if url != blank -%}<a class="aurora-mnav__all" href="{{ url }}">{{ all_label }} {{ label }}</a>{%- endif -%}
      {%- assign open1 = true -%}
    {%- else -%}
      <a class="aurora-mnav__link{% if level == 2 %} aurora-mnav__leaf{% endif %}" href="{{ url | default: '#' }}">{{ label }}</a>
    {%- endif -%}
  {%- else -%}
    {%- comment -%} Desktop: top items with a dropdown of columns (level 1) and links (level 2). {%- endcomment -%}
    {%- if level <= 1 and open1 -%}</div>{%- assign open1 = false -%}{%- endif -%}
    {%- if level == 0 and open0 -%}</div></div></li>{%- assign open0 = false -%}{%- endif -%}
    {%- if level == 0 -%}
      <li class="aurora-nav__item{% if has_children %} aurora-nav__item--panel{% endif %}">
        <a class="aurora-nav__top nav-link" href="{{ url | default: '#' }}"{% if has_children %} aria-haspopup="true"{% endif %}>
          <span>{{ label }}</span>{% if has_children %}{{ chevron }}{% endif %}
        </a>
      {%- if has_children -%}
        <div class="aurora-nav__panel"><div class="aurora-nav__cols">
        {%- assign open0 = true -%}
      {%- else -%}
        </li>
      {%- endif -%}
    {%- elsif level == 1 -%}
      <div class="aurora-nav__col">
        <a class="aurora-nav__head" href="{{ url | default: '#' }}">{{ label }}</a>
      {%- if has_children -%}
        {%- assign open1 = true -%}
      {%- else -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <a class="aurora-nav__leaf" href="{{ url | default: '#' }}">{{ label }}</a>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if mode == 'mobile' -%}
  {%- if open1 -%}</div></details>{%- endif -%}
  {%- if open0 -%}</div></details>{%- endif -%}
{%- else -%}
  {%- if open1 -%}</div>{%- endif -%}
  {%- if open0 -%}</div></div></li>{%- endif -%}
{%- endif -%}
