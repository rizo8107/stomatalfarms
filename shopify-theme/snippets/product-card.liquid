{% doc %}
  Renders a product card, matching src/components/ShopifyProductCard.tsx.

  Product data comes from the native Shopify product object rather than a
  client-side Storefront API call, so the card is fully server-rendered.
  Variant switching (price, compare-at price, discount badge) runs client-side
  in the <product-card> custom element.

  Add to Cart is inert in Phase 1 — the native Ajax cart lands in Phase 2 —
  and the WhatsApp ordering flow for microgreens lands in Phase 3.

  @param {object} product - The Shopify product object

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{%- liquid
  assign title_lower = product.title | downcase
  assign description_lower = product.description | downcase

  assign badge = null
  if title_lower contains 'incense cup'
    assign badge = 'Best Seller'
  elsif title_lower contains 'incense stick'
    assign badge = 'Everyday'
  elsif title_lower contains 'ghee lamp'
    assign badge = 'Sacred'
  elsif title_lower contains 'combo'
    assign badge = 'Best Value'
  endif

  assign is_microgreens = false
  if title_lower contains 'microgreen' or title_lower contains 'leafy' or description_lower contains 'microgreen'
    assign is_microgreens = true
  endif

  assign selected_variant = product.variants.first
  assign current_price = selected_variant.price | divided_by: 100.0 | round
  assign original_price = 0
  if selected_variant.compare_at_price
    assign original_price = selected_variant.compare_at_price | divided_by: 100.0 | round
  endif
  assign has_discount = false
  assign discount_pct = 0
  if selected_variant.compare_at_price > selected_variant.price
    assign has_discount = true
    assign price_delta = selected_variant.compare_at_price | minus: selected_variant.price | times: 100.0
    assign discount_pct = price_delta | divided_by: selected_variant.compare_at_price | round
  endif
-%}

<product-card>
  <a href="{{ product.url }}" class="group block h-full">
    <div
      class="flex flex-col h-full rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5 border"
      style="background: #fffbf5; border-color: rgba(46,63,37,0.10);"
    >
      <div class="relative aspect-square overflow-hidden bg-[#f7f1e8]">
        {%- if badge -%}
          <span
            class="absolute top-3 left-3 z-10 text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full text-white shadow-md"
            style="background: linear-gradient(135deg, #2e4e18, #4f7a2e);"
          >
            {{ badge }}
          </span>
        {%- endif -%}
        <span
          data-discount-badge
          class="absolute top-3 right-3 z-10 text-[10px] font-black px-2.5 py-1 rounded-full text-white shadow-md"
          style="background: #b56c3d;"
          {% unless has_discount and discount_pct > 0 %}hidden{% endunless %}
        >
          {{ discount_pct }}% OFF
        </span>

        {%- if product.featured_image -%}
          <img
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          >
        {%- else -%}
          <div class="w-full h-full flex items-center justify-center text-[#6a7462] text-xs">No image</div>
        {%- endif -%}
      </div>

      <div class="flex flex-col flex-1 p-4 gap-3">
        <div class="flex-1">
          <h3
            class="text-xl md:text-2xl font-semibold text-[#1e2519] leading-tight group-hover:text-[#4f7a2e] transition-colors mb-1.5"
            style="font-family: 'Cormorant Garamond', serif;"
          >
            {{ product.title }}
          </h3>

          <div class="flex items-center gap-1 mb-2">
            <div class="flex">
              {%- for i in (1..5) -%}
                <svg class="w-2.5 h-2.5 text-[#b56c3d] fill-current" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              {%- endfor -%}
            </div>
            <span class="text-[10px] text-[#6a7462] font-bold">5.0</span>
          </div>

          <div class="flex flex-wrap gap-x-2 gap-y-1 mb-2">
            {%- assign card_features = 'Natural,Lab Tested,Chemical Free' | split: ',' -%}
            {%- for feature in card_features -%}
              <span class="text-[9px] text-[#4f7a2e] font-bold uppercase tracking-wider flex items-center gap-1">
                <span class="w-1 h-1 rounded-full bg-[#4f7a2e]/40"></span>
                {{ feature }}
              </span>
            {%- endfor -%}
          </div>

          {%- if product.variants.size > 1 -%}
            <div class="flex flex-wrap gap-1.5 mt-2">
              {%- for variant in product.variants -%}
                <button
                  type="button"
                  data-variant-option
                  data-variant-id="{{ variant.id }}"
                  data-price="{{ variant.price | divided_by: 100.0 | round }}"
                  data-compare-at-price="{% if variant.compare_at_price %}{{ variant.compare_at_price | divided_by: 100.0 | round }}{% endif %}"
                  data-discount-pct="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}{% else %}0{% endif %}"
                  class="px-2.5 py-1 rounded-full text-[10px] font-semibold transition-all border"
                  {% if forloop.first %}
                    style="background: #4f7a2e; color: #fff; border-color: #4f7a2e;"
                    aria-pressed="true"
                  {% else %}
                    style="background: transparent; color: #6a7462; border-color: rgba(46,63,37,0.20);"
                    aria-pressed="false"
                  {% endif %}
                >
                  {{ variant.title }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <div class="flex flex-col gap-2.5 mt-auto">
          <div class="flex items-baseline gap-2">
            <span data-current-price class="text-lg font-extrabold text-[#1e2519]">₹{{ current_price }}</span>
            <span
              data-original-price
              class="text-xs text-[#6a7462] line-through"
              {% unless has_discount and original_price > 0 %}hidden{% endunless %}
            >₹{{ original_price }}</span>
          </div>

          <button
            type="button"
            data-product-cta
            {% unless is_microgreens %}data-ajax-add data-variant-id="{{ selected_variant.id }}"{% endunless %}
            class="w-full py-2.5 rounded-full text-[13px] font-black text-white shadow-md transition-all hover:opacity-90 active:scale-95"
            style="background: linear-gradient(135deg, #2e4e18, #4f7a2e);"
          >
            {% if is_microgreens %}Order on WhatsApp{% else %}Add to Cart{% endif %}
          </button>
        </div>
      </div>
    </div>
  </a>
</product-card>
