{% comment %}
  WhatsApp product ordering component
  - Collection-controlled
  - Variant-aware
  - Quantity-aware
  - Accessible
  - No external dependencies

  Required:
  - product
  - whatsapp_phone
  - whatsapp_collection_handle
{% endcomment %}

{% liquid
  assign whatsapp_collection_handle = whatsapp_collection_handle | default: 'whatsapp-orders'
  assign whatsapp_phone = whatsapp_phone | default: '916379033131'
  assign whatsapp_button_label = whatsapp_button_label | default: 'Order via WhatsApp'
  assign whatsapp_heading = whatsapp_heading | default: 'Order through WhatsApp'
  assign whatsapp_description = whatsapp_description | default: 'Chat with us to confirm availability and place your order.'
  assign whatsapp_enabled = false

  for collection in product.collections
    if collection.handle == whatsapp_collection_handle
      assign whatsapp_enabled = true
      break
    endif
  endfor

  assign current_variant = product.selected_or_first_available_variant
%}

{% if whatsapp_enabled %}
  <div
    class="whatsapp-order"
    data-whatsapp-order
    data-whatsapp-phone="{{ whatsapp_phone }}"
    data-product-title="{{ product.title | escape }}"
    data-product-url="{{ shop.url }}{{ product.url }}"
    data-product-price="{{ current_variant.price | money_without_currency | escape }}"
  >
    <div class="whatsapp-order__content">
      <div class="whatsapp-order__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="presentation">
          <path d="M20.5 3.5A11.9 11.9 0 0 0 12.03 0C5.45 0 .1 5.35.1 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.25-1.64a11.9 11.9 0 0 0 5.77 1.47h.01c6.58 0 11.93-5.35 11.93-11.93 0-3.19-1.24-6.18-3.46-8.4ZM12.03 21.8h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.71.97.99-3.62-.23-.37a9.85 9.85 0 0 1-1.51-5.26C2.17 6.49 6.59 2.07 12.03 2.07c2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.9 6.99c0 5.44-4.43 9.84-9.89 9.84Zm5.4-7.37c-.3-.15-1.77-.87-2.05-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.74-1.64-2.04-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.68-1.64-.93-2.25-.25-.59-.5-.51-.68-.52h-.58c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.09 4.49.71.31 1.26.5 1.69.64.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/>
        </svg>
      </div>

      <div class="whatsapp-order__text">
        <h3>{{ whatsapp_heading }}</h3>
        <p>{{ whatsapp_description }}</p>
      </div>
    </div>

    <button
      type="button"
      class="whatsapp-order__button"
      data-whatsapp-order-button
      aria-label="{{ whatsapp_button_label }} for {{ product.title | escape }}"
    >
      <span class="whatsapp-order__button-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="presentation">
          <path d="M20.5 3.5A11.9 11.9 0 0 0 12.03 0C5.45 0 .1 5.35.1 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.25-1.64a11.9 11.9 0 0 0 5.77 1.47h.01c6.58 0 11.93-5.35 11.93-11.93 0-3.19-1.24-6.18-3.46-8.4ZM12.03 21.8h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.71.97.99-3.62-.23-.37a9.85 9.85 0 0 1-1.51-5.26C2.17 6.49 6.59 2.07 12.03 2.07c2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.9 6.99c0 5.44-4.43 9.84-9.89 9.84Zm5.4-7.37c-.3-.15-1.77-.87-2.05-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.74-1.64-2.04-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.68-1.64-.93-2.25-.25-.59-.5-.51-.68-.52h-.58c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.09 4.49.71.31 1.26.5 1.69.64.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/>
        </svg>
      </span>
      <span data-whatsapp-order-label>{{ whatsapp_button_label }}</span>
      <span class="whatsapp-order__arrow" aria-hidden="true">↗</span>
    </button>

    <p class="whatsapp-order__note">
      <span aria-hidden="true">✓</span>
      No payment required here. We'll confirm your order in WhatsApp.
    </p>
  </div>

  <style>
    .whatsapp-order {
      --wa-green: #128c7e;
      --wa-green-dark: #075e54;
      --wa-green-soft: #e9f7f3;
      --wa-border: #d9e9e5;
      --wa-text: #182b27;
      --wa-muted: #60736e;

      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
      padding: 20px;
      border: 1px solid var(--wa-border);
      border-radius: 16px;
      background: linear-gradient(180deg, #ffffff 0%, #f7fcfa 100%);
      box-sizing: border-box;
    }

    .whatsapp-order__content {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .whatsapp-order__icon {
      display: flex;
      flex: 0 0 44px;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      color: #fff;
      background: var(--wa-green);
    }

    .whatsapp-order__icon svg {
      width: 24px;
      height: 24px;
      fill: currentColor;
    }

    .whatsapp-order__text {
      min-width: 0;
    }

    .whatsapp-order__text h3 {
      margin: 0 0 4px;
      color: var(--wa-text);
      font-size: 16px;
      font-weight: 650;
      line-height: 1.35;
    }

    .whatsapp-order__text p {
      margin: 0;
      color: var(--wa-muted);
      font-size: 13px;
      line-height: 1.5;
    }

    .whatsapp-order__button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      min-height: 52px;
      padding: 14px 18px;
      border: 0;
      border-radius: 10px;
      color: #fff;
      background: var(--wa-green);
      cursor: pointer;
      font: inherit;
      font-size: 15px;
      font-weight: 650;
      line-height: 1.2;
      transition:
        background-color .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
    }

    .whatsapp-order__button:hover {
      background: var(--wa-green-dark);
      box-shadow: 0 5px 14px rgba(7, 94, 84, .16);
      transform: translateY(-1px);
    }

    .whatsapp-order__button:focus-visible {
      outline: 3px solid rgba(18, 140, 126, .35);
      outline-offset: 3px;
    }

    .whatsapp-order__button:active {
      transform: translateY(0);
    }

    .whatsapp-order__button:disabled {
      cursor: wait;
      opacity: .75;
    }

    .whatsapp-order__button-icon {
      display: inline-flex;
    }

    .whatsapp-order__button-icon svg {
      width: 20px;
      height: 20px;
      fill: currentColor;
    }

    .whatsapp-order__arrow {
      margin-left: 2px;
      font-size: 18px;
      line-height: 1;
    }

    .whatsapp-order__note {
      display: flex;
      align-items: flex-start;
      gap: 6px;
      margin: 0;
      color: var(--wa-muted);
      font-size: 12px;
      line-height: 1.45;
    }

    .whatsapp-order__note span {
      color: var(--wa-green);
      font-weight: 700;
    }

    @media (max-width: 749px) {
      .whatsapp-order {
        padding: 16px;
        gap: 14px;
        border-radius: 14px;
      }

      .whatsapp-order__button {
        min-height: 50px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .whatsapp-order__button {
        transition: none;
      }
    }
  </style>

  <script>
    (() => {
      if (window.__whatsappOrderInitialized) return;
      window.__whatsappOrderInitialized = true;

      const getVariantData = (root) => {
        const productForm = root.closest('section, .shopify-section, product-info, .product');
        const variantInput = productForm?.querySelector(
          'form[action*="/cart/add"] input[name="id"]'
        );

        const quantityInput = productForm?.querySelector(
          'form[action*="/cart/add"] input[name="quantity"]'
        );

        const variantId = variantInput?.value || '';
        const quantity = quantityInput?.value || '1';

        let variantTitle = '';
        let variantPrice = root.dataset.productPrice || '';

        const productJson = productForm?.querySelector(
          'script[type="application/json"]'
        );

        if (productJson) {
          try {
            const product = JSON.parse(productJson.textContent);
            const variant = product.variants?.find(
              (item) => String(item.id) === String(variantId)
            );

            if (variant) {
              variantTitle = variant.title !== 'Default Title' ? variant.title : '';
              variantPrice = (variant.price / 100).toFixed(2);
            }
          } catch (error) {
            // Keep the fallback values if product JSON is unavailable.
          }
        }

        return { variantId, variantTitle, quantity, variantPrice };
      };

      const buildMessage = (root) => {
        const { variantId, variantTitle, quantity, variantPrice } =
          getVariantData(root);

        const productTitle = root.dataset.productTitle || '';
        const productUrl = root.dataset.productUrl || '';

        const lines = [
          `Hi, I am interested in: ${productTitle}`,
          variantTitle ? `Variant: ${variantTitle}` : '',
          variantId ? `Variant ID: ${variantId}` : '',
          `Quantity: ${quantity}`,
          variantPrice ? `Price: ${variantPrice}` : '',
          `Product link: ${productUrl}`,
          '',
          'Please share availability and ordering details.'
        ].filter(Boolean);

        return lines.join('\n');
      };

      document.addEventListener('click', (event) => {
        const button = event.target.closest('[data-whatsapp-order-button]');
        if (!button) return;

        const root = button.closest('[data-whatsapp-order]');
        if (!root) return;

        const phone = root.dataset.whatsappPhone;
        const message = buildMessage(root);
        const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;

        button.disabled = true;

        const label = button.querySelector('[data-whatsapp-order-label]');
        const originalLabel = label?.textContent;

        if (label) label.textContent = 'Opening WhatsApp…';

        window.open(url, '_blank', 'noopener,noreferrer');

        window.setTimeout(() => {
          button.disabled = false;
          if (label) label.textContent = originalLabel;
        }, 1200);
      });
    })();
  </script>
{% endif %}