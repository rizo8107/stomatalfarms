{%- comment -%}
  Aurora: floating WhatsApp chat button (Theme settings › Aurora: Cart & WhatsApp).
{%- endcomment -%}
{%- if settings.aurora_wa_enable and settings.aurora_wa_number != blank -%}
  {%- liquid
    assign wa_number = settings.aurora_wa_number | remove: '+' | remove: ' ' | remove: '-'
    assign wa_message = settings.aurora_wa_message
    if template.name == 'product'
      assign wa_message = wa_message | append: ' (' | append: product.title | append: ')'
    endif
  -%}
  <a
    class="aurora-wa-float aurora-wa-float--{{ settings.aurora_wa_position }}{% if template.name == 'product' %} aurora-wa-float--raised{% endif %}"
    href="https://wa.me/{{ wa_number }}?text={{ wa_message | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ settings.aurora_wa_label | escape }} on WhatsApp"
  >
    <span class="aurora-wa-float__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="#ffffff"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3a.5.5 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3z"/></svg>
    </span>
    {%- if settings.aurora_wa_label != blank -%}
      <span class="aurora-wa-float__text">
        <strong>{{ settings.aurora_wa_label }}</strong>
        {%- if settings.aurora_wa_subtext != blank -%}<small>{{ settings.aurora_wa_subtext }}</small>{%- endif -%}
      </span>
    {%- endif -%}
  </a>
{%- endif -%}
